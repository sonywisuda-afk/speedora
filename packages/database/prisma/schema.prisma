// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Mirrors VideoStatus in packages/shared/src/types/video.ts
enum VideoStatus {
  IMPORTING
  UPLOADED
  // Quality Validation roadmap (Fase 0 design, Phase 1) - reached once
  // probe-video.worker.ts's ffprobe pass succeeds (clean or with only
  // Warning/Info-tier findings - an Error-tier finding goes to FAILED
  // instead, same as every other pipeline stage's failure). The video sits
  // here until the user submits Processing Settings (POST
  // /videos/:id/start-processing), which is what actually enqueues
  // TRANSCRIBE - the one deliberate break from this pipeline's otherwise-
  // universal "self-chain to the next stage automatically" convention,
  // since this is the one stage that must wait for a human decision.
  PENDING_SETTINGS
  TRANSCRIBED
  CLIPS_DETECTED
  RENDERED
  FAILED
}

// Mirrors CaptionStyle in packages/shared/src/types/video.ts
enum CaptionStyle {
  DEFAULT
  KARAOKE
  BOLD_HIGHLIGHT
}

// Milestone 5C-B (AI Operations Dashboard) - the first role concept in this
// codebase. CREATOR (default) is every normal signup; the other three gate
// GET /ops/ai/* (RolesGuard) since that surface pools aggregate data across
// EVERY user's clips, not just the requester's own - a real access-control
// boundary, not a UX nicety. No self-service elevation endpoint exists -
// granted only via apps/api/src/scripts/grant-role.ts, see
// docs/operations-runbook.md.
enum UserRole {
  CREATOR
  ADMIN
  AI_ENGINEER
  OPERATOR
}

// Mirrors TranscriptionProvider in packages/shared/src/types/video.ts. Chosen
// per-video at upload/import time (see VideosService.upload/.importFromYoutube),
// not a persistent account setting - GROQ (Whisper large-v3-turbo) is the
// free default; OPENAI (Whisper-1) is the paid "premium" tier, gated by
// PremiumCredit below.
enum TranscriptionProvider {
  GROQ
  OPENAI
}

// One row per Midtrans Snap transaction for a single premium (OpenAI Whisper)
// transcription. Created PENDING when the user starts checkout, flipped to
// PAID/FAILED/EXPIRED by the Midtrans webhook (PaymentsService.handleWebhook -
// never trusted from the client-side Snap callback alone, since that can be
// spoofed or interrupted). videoId is set once an available PAID credit is
// atomically claimed by a video upload/import that requested OPENAI - null +
// status=PAID is exactly "unused, spendable credit" (see
// VideosService.consumePremiumCredit). One-time purchase, not a subscription:
// a credit is worth exactly one video's transcription, never renews.
enum PremiumCreditStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
}

model PremiumCredit {
  id              String              @id @default(cuid())
  userId          String
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  status          PremiumCreditStatus @default(PENDING)
  // Rupiah, whole units only (Midtrans gross_amount has no subunit for IDR) -
  // stored redundantly from the price constant at purchase time so a later
  // price change doesn't rewrite the meaning of past transactions.
  amount          Int
  // Midtrans's own transaction identifier - what its Snap API and webhook
  // notification both key off of. Prefixed/generated by PaymentsService, not
  // Midtrans itself, so it's known before the Snap API call that creates it.
  midtransOrderId String              @unique
  videoId         String?             @unique
  video           Video?              @relation(fields: [videoId], references: [id], onDelete: SetNull)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([userId])
}

// Mirrors SocialPlatform in packages/shared/src/types/social.ts. YOUTUBE
// (Fase 6a) picked first for lowest-friction OAuth; TIKTOK (Fase 6d) added
// second; INSTAGRAM added third - see CLAUDE.md's "Publish Center" section
// for all three. FACEBOOK/THREADS added in Multi-Platform Publishing
// Expansion, Phase 1 - both Meta Graph API products, following Instagram's
// container-create -> poll -> publish pattern. LINKEDIN added in Phase 2 -
// a genuinely different multi-part byte-upload model (LinkedIn's Videos
// API), not the Meta "fetch from a URL" pattern. PINTEREST added in
// Phase 3 - a board-scoped video Pin, requiring a mandatory cover image
// unlike every other platform. X added in Phase 4 - best-effort only, see
// CLAUDE.md's Publish Center section: as of Feb 2026 X has no free API
// tier for new developer apps (pay-per-use, $0.015/post, or a legacy paid
// tier) - this is a real, ongoing operating cost for whoever owns the X
// Developer App credentials, not a one-time setup step like every other
// platform here.
enum SocialPlatform {
  YOUTUBE
  TIKTOK
  INSTAGRAM
  FACEBOOK
  THREADS
  LINKEDIN
  PINTEREST
  X
}

// Mirrors PublishStatus in packages/shared/src/types/social.ts. SCHEDULED
// (Fase 6c) is a row waiting for its scheduledAt to arrive - the
// schedule-publish-clip poller (apps/worker) claims it (-> QUEUED) and
// enqueues the actual publish-clip job at that point, same as an immediate
// "publish now" skips SCHEDULED entirely and starts at QUEUED.
enum PublishStatus {
  SCHEDULED
  QUEUED
  PUBLISHING
  PUBLISHED
  FAILED
}

model User {
  id                              String    @id @default(cuid())
  email                           String    @unique
  // bcrypt hash - never the plaintext password. Nullable since Tahap 2
  // (OAuth Login) - an account created via "Continue with Google/GitHub"
  // may never set one; AuthService.validateUser()/changePassword() both
  // null-check before comparing, same generic "Invalid email or password"
  // failure as any other credential mismatch (never a distinct error that
  // would confirm "this account has no password").
  password                        String?
  // Milestone 5C-B - see UserRole above. Every normal signup gets CREATOR.
  role                            UserRole  @default(CREATOR)
  // Forgot-password (Fase 8) - SHA-256 hash of a random token, never the raw
  // token itself (that only ever exists in the emailed reset link) - a DB
  // leak alone shouldn't be enough to reset anyone's password, same
  // reasoning as bcrypt-hashing the login password above. A new
  // forgot-password request overwrites both fields, implicitly invalidating
  // any earlier unused request - only the most recent one is ever honored.
  resetPasswordTokenHash          String?   @unique
  resetPasswordTokenExpiresAt     DateTime?
  // Authentication Foundation Sprint 2 (Account Trust) - defaults false for
  // every new registration; pre-existing rows also become false post-
  // migration (no way to know if an existing account's email was ever
  // confirmed - a one-way door, not backfilled as verified). Token fields
  // are the identical hash-at-rest convention as resetPasswordTokenHash
  // above (SHA-256 hex digest, raw token only ever in the emailed link) -
  // same pattern, applied a second time, with a longer TTL (24h vs 1h) since
  // a signup confirmation email is expected to sit unread longer than a live
  // password reset request. A new verify/resend request overwrites both
  // fields, same "only the most recent one is ever honored" behavior.
  emailVerified                   Boolean   @default(false)
  emailVerificationTokenHash      String?   @unique
  emailVerificationTokenExpiresAt DateTime?
  // Tahap 2 Step 2 Sprint 1 (MFA Foundation) - mfaEnabled stays false until
  // the user has verified one real TOTP code from their authenticator app
  // (MfaController's enroll -> confirm two-step), so a half-finished
  // enrollment can never lock an account out. mfaSecret is AES-256-GCM
  // ciphertext via @speedora/social's encryptToken/decryptToken
  // (TOKEN_ENCRYPTION_KEY) - unlike every other token/secret in this schema
  // it must be decryptable to check a future code against it, so it can't
  // be a one-way hash like resetPasswordTokenHash/
  // emailVerificationTokenHash above. Overwritten (not accumulated) by a
  // fresh /enroll call - an abandoned/never-confirmed enrollment just gets
  // silently replaced, no cleanup job needed. Both null again once MFA is
  // disabled - see MfaController.disable.
  mfaEnabled                      Boolean   @default(false)
  mfaSecret                       String?
  mfaEnabledAt                    DateTime?
  // Sprint 03d (Export Center roadmap) - Brand Report's minimal Brand Kit.
  // No new settings system - these live directly on User, same "smallest
  // viable" posture the roadmap called for. brandLogoUrl is a raw storage
  // key, never exposed as-is (same "never the raw key" convention as every
  // other resource) - GET /brand-kit/logo resolves it. All three null until
  // the user sets them; Brand Report falls back to default (unbranded)
  // styling when unset rather than blocking creation - same graceful-
  // degradation posture as a missing SMTP_HOST just logging a warning
  // elsewhere in this codebase.
  brandLogoUrl                    String?
  brandPrimaryColor               String?
  brandSecondaryColor             String?
  // Brand Kit roadmap (P3a) - one of packages/contracts's curated
  // FONT_FAMILIES keys (e.g. "Inter", "Open Sans"), not an arbitrary string -
  // enforced by BrandKitService/UpdateBrandKitDto, not a DB-level enum (same
  // "app-level enum, not a Postgres one" posture CaptionStyle itself
  // deliberately avoids for its own reasons documented on that enum). Null
  // until set; render-enqueue time falls back to build-ass.ts's own default
  // ('Inter') when null, same as an unset Clip.captionLanguage falling back
  // to the original (untranslated) transcript text.
  brandFontFamily                 String?
  // Watermark roadmap (P3c) - brandWatermarkUrl is a raw storage key
  // (watermarks/<uuid>.png, same convention as brandLogoUrl - SVG uploads
  // are rasterized to PNG at upload time since ffmpeg can't decode SVG
  // directly). opacity/scale/margin are 0-1 fractions - scale/margin are
  // fractions of the OUTPUT video's width, resolution-independent by
  // construction rather than a fixed pixel size. position is one of
  // @speedora/shared's WATERMARK_POSITIONS. All null until set; render-
  // enqueue time (ClipsService.resolveWatermark) falls back to code-level
  // defaults (opacity 0.8, scale 0.15, margin 0.03, position BOTTOM_RIGHT)
  // - same "null means use the sensible default" posture brandFontFamily
  // above already uses.
  brandWatermarkUrl               String?
  brandWatermarkOpacity           Float?
  brandWatermarkScale             Float?
  brandWatermarkMargin            Float?
  brandWatermarkPosition          String?
  // Intro roadmap (P3d) - brandIntroUrl is a raw storage key
  // (intros/<uuid><ext>, same convention as brandWatermarkUrl). brandIntroType
  // is 'video' | 'image', set at upload time from the validated mimetype
  // (BrandKitController) rather than sniffed from the extension at render
  // time - the worker needs it instantly without re-probing the file.
  // brandIntroImageDurationSeconds only matters when brandIntroType is
  // 'image' (a still has no inherent duration, unlike a video) - null means
  // ClipsService/ffmpeg.ts's own default (3s) applies, same "null means the
  // sensible default" posture every other Brand Kit field already uses. A
  // video intro's duration is never stored - it's re-derived (and capped)
  // fresh at every render via ffprobe, since apps/api has no ffmpeg/ffprobe
  // dependency to compute it at upload time (see concatIntro()'s own
  // comment).
  brandIntroUrl                   String?
  brandIntroType                  String?
  brandIntroImageDurationSeconds  Float?
  // Outro roadmap (P3e) - same shape as brandIntro* above, applied at the
  // end of the render instead of the start (see ffmpeg.ts's
  // concatBrandSegment, generalized from P3d's concatIntro to take a
  // 'start' | 'end' position rather than duplicating the whole pipeline).
  brandOutroUrl                   String?
  brandOutroType                  String?
  brandOutroImageDurationSeconds  Float?
  createdAt                       DateTime  @default(now())
  updatedAt                       DateTime  @updatedAt

  videos                          Video[]
  socialAccounts                  SocialAccount[]
  premiumCredits                  PremiumCredit[]
  activityEvents                  ActivityEvent[]
  activityDeletionLogs            ActivityDeletionLog[]
  sentInvites                     PendingInvite[]
  exportJobs                      ExportJob[]
  notifications                   Notification[]
  notificationPreferences         NotificationPreference[]
  notificationWebhooks            NotificationWebhook[]
  // Notification Center v2 (Phase 1 - Database & Backend Foundation)
  notificationThreads             NotificationThread[]
  notificationGroups              NotificationGroup[]
  notificationReadReceipts        NotificationReadReceipt[]
  notificationCategoryPreferences NotificationCategoryPreference[]
  // Sprint 5A (Collaboration Foundation) - ownedWorkspaces is "created by"
  // display metadata only; workspaceMemberships is the real source of
  // access (see WorkspaceMembership below). Every User has at least one
  // workspaceMemberships row (their own isPersonal workspace, role OWNER).
  ownedWorkspaces                 Workspace[]                      @relation("WorkspaceCreator")
  workspaceMemberships            WorkspaceMembership[]
  // Sprint 5B (Shared Clips)
  createdShareLinks               ShareLink[]
  // Sprint 5C (Comments)
  comments                        Comment[]                        @relation("CommentAuthor")
  resolvedComments                Comment[]                        @relation("CommentResolver")
  commentMentions                 CommentMention[]
  commentReactions                CommentReaction[]
  // Sprint 5D (Approval)
  requestedApprovals              Approval[]                       @relation("ApprovalRequester")
  reviewedApprovals               Approval[]                       @relation("ApprovalReviewer")
  approvalEvents                  ApprovalEvent[]
  // Sprint 5E (Version Compare & History)
  clipVersionsCreated             ClipVersion[]
  // Sprint 5F (Audit Log)
  auditLogEntries                 AuditLogEntry[]
  // Publishing Expansion Phase 6 (Scheduling)
  campaignsCreated                Campaign[]
  // Sprint 6K (Conversion - first-party click-tracking)
  createdTrackedLinks             TrackedLink[]
  // Subtitle Presets roadmap (P3b)
  subtitlePresets                 SubtitlePreset[]
  // Template Presets roadmap (P3f)
  brandKitTemplates               BrandKitTemplate[]
  // Natural Language AI Search roadmap (P4)
  aiSearchRequests                AiSearchRequest[]
  // Pre-Processing Settings roadmap (Phase 0/1)
  processingPresets               ProcessingPreset[]
  // Authentication Foundation Sprint 1 (Tahap 1 roadmap)
  sessions                        Session[]
  // Tahap 2 Step 1 (OAuth Login)
  oauthIdentities                 OAuthIdentity[]
  // Tahap 2 Step 2 Sprint 1 (MFA Foundation)
  mfaRecoveryCodes                MfaRecoveryCode[]
  // Tahap 2 Step 2 Sprint 2a (MFA Enforcement)
  trustedDevices                  TrustedDevice[]
  // Tahap 3 Sprint 1 (Passkey Foundation)
  passkeys                        Passkey[]
}

model Video {
  id                        String                @id @default(cuid())
  ownerId                   String
  owner                     User                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  // Empty string while status is IMPORTING (see VideosService.importFromYoutube) -
  // apps/worker's import-youtube job fills in the real object storage key
  // once the download finishes. Kept non-nullable rather than String? so
  // every other reader of this field (findSourceOrThrow, transcribe/
  // render-clip's sourceUrl reads, etc.) doesn't need a null-check for a
  // state those code paths never actually run in.
  sourceUrl                 String
  // Display name only - never used for storage keys/lookups (those are
  // always the cuid `id` or the object-storage key in sourceUrl). Direct
  // upload: the original filename (Express.Multer.File.originalname).
  // YouTube import: fetched separately by apps/worker's import-youtube job
  // (yt-dlp has no title available at the API-request instant, before the
  // download starts) - null until that job's first progress write, same
  // "arrives asynchronously" pattern as durationSeconds. Null for rows
  // created before this field existed - not backfilled (Dashboard falls
  // back to "Untitled video").
  title                     String?
  // Original youtube.com/youtu.be URL, set only by
  // VideosService.importFromYoutube() - null for a direct file upload.
  // Needed so VideosService.retry() can re-enqueue import-youtube (rather
  // than transcribe, which would run against the still-empty sourceUrl
  // above) if a video fails before the download ever finished.
  importSourceUrl           String?
  status                    VideoStatus           @default(UPLOADED)
  durationSeconds           Float?
  // Bytes of the source file in object storage - direct upload sets this
  // synchronously from the already-in-memory multer buffer's length;
  // YouTube import sets it via an fs.stat() of the downloaded file right
  // before upload (same instant computeFileMd5Hex-style pattern render-clip
  // already uses for outputSizeBytes below). Feeds the Dashboard's per-owner
  // "Storage Used" stat cheaply from Postgres instead of scanning the whole
  // S3/R2/MinIO bucket (see packages/storage's getBucketUsage(), which is
  // bucket-wide and not owner-scoped). Null for pre-existing rows.
  sourceSizeBytes           Int?
  // Quality Validation roadmap (Fase 0 design, Phase 1) - written once by
  // probe-video.worker.ts's ffprobe pass (a single `-show_streams
  // -show_format -of json` call, not the 4 narrow single-field probes
  // transcribe.worker.ts/render-clip.worker.ts already use for their own
  // unrelated purposes - those stay untouched). All nullable and null for
  // every pre-existing row (never backfilled) and for any row whose probe
  // never completed (see VideosService.retry's own inferred branch for
  // this). durationSeconds above is populated by this same pass for the
  // first time - no prior code path ever wrote to it.
  width                     Int?
  height                    Int?
  fps                       Float?
  videoCodec                String?
  videoBitrate              Int?
  audioCodec                String?
  audioSampleRate           Int?
  audioChannels             Int?
  audioBitrate              Int?
  // The structured { errors: [], warnings: [], info: [] } result of
  // packages/video-validation's rule evaluation over the probed metadata
  // above (Phase 2) - null until that phase lands, and for any video whose
  // probe found no Error-tier issue but also never had rules evaluated
  // against it (pre-Phase-2 rows). Kept even after the user proceeds past
  // Processing Settings, so a future dashboard can show "processed despite
  // warnings: low resolution, low bitrate" per the original design ask.
  validationReport          Json?
  // Object storage key for a single extracted thumbnail frame
  // (thumbnails/<id>.webp - .jpg for rows extracted before Phase 2's WebP
  // switch, never backfilled, still served correctly since the API derives
  // Content-Type from this key's own extension), set by transcribe.worker.ts
  // (best-effort - a failed extraction never fails the transcribe job) right
  // after the source video is downloaded locally. Never exposed to the client
  // as this raw key - VideosService.mapVideoWithClips computes a
  // `/videos/:id/thumbnail` endpoint path instead, same treatment as
  // sourceUrl/downloadUrl. Null for pre-existing rows and while extraction is
  // still pending/failed - never backfilled.
  thumbnailUrl              String?
  // Phase 2 (image optimization roadmap) - a tiny (~8px-wide) blurred version
  // of thumbnailUrl, base64 data-URL encoded, generated in the same
  // best-effort extraction step. Small enough to return inline in the video
  // DTO (unlike the full thumbnail, which stays behind its own endpoint) so
  // the frontend has *something* to paint before the real image loads. Null
  // whenever thumbnailUrl is null (same lifecycle), and for pre-existing rows
  // predating this column.
  thumbnailBlurDataUrl      String?
  // Phase 3 (Hover Preview/Storyboard roadmap) - object storage keys for N
  // evenly-spaced frames (transcribe.worker.ts extracts each independently,
  // best-effort - some can fail while others succeed, so this is the actual
  // list of keys that succeeded, never a fabricated fixed-N array). Never
  // exposed to the client as raw keys - VideosService.mapVideoWithClips
  // computes `/videos/:id/storyboard/:index` endpoint paths instead, same
  // treatment as thumbnailUrl. Empty array (not null) once extraction has
  // run and found nothing; null only for pre-existing rows predating this
  // column.
  storyboardFrameUrls       Json?
  // Phase 3 (Animated Thumbnail roadmap) - object storage key for a short,
  // muted, looping animated WebP (extractAnimatedPreview in ffmpeg.ts, same
  // best-effort extraction step as thumbnailUrl above, a separate call so a
  // thumbnail failure doesn't imply an animated-preview failure or vice
  // versa). Never exposed to the client as a raw key - same
  // "/videos/:id/animated-thumbnail" endpoint-path treatment as thumbnailUrl.
  // Null while extraction is still pending/failed, or for pre-existing rows.
  animatedThumbnailUrl      String?
  // Phase 3 (Hover Preview roadmap) - object storage key for a longer,
  // smoother looping WebP than animatedThumbnailUrl above (same
  // extractAnimatedPreview() primitive, a longer/smoother config since this
  // is the main content of a hover interaction, not background decoration -
  // see ffmpeg.ts's own comment). A genuinely separate asset/column, not a
  // re-purposed animatedThumbnailUrl, because it's fetched on-demand only
  // (only on hover, never eagerly with the card) rather than always-shown.
  // Never exposed to the client as a raw key - same
  // "/videos/:id/hover-preview" endpoint-path treatment as thumbnailUrl.
  // Null while extraction is still pending/failed, or for pre-existing rows.
  hoverPreviewUrl           String?
  // Phase 4 of the thumbnail roadmap (AI Thumbnail Selection, Level 1 -
  // "which clip is the video's cover"). Set by render-clip.worker.ts once
  // every sibling clip has rendered and rankClips() has run, by COPYING
  // (never re-extracting) the rank-1 clip's own already-extracted
  // thumbnailUrl/thumbnailBlurDataUrl. Deliberately ADDITIVE, not an
  // overwrite of thumbnailUrl/thumbnailBlurDataUrl above - those keep
  // serving their existing purpose (a placeholder available from the
  // moment the raw source is downloaded, before any clip exists) - the API
  // layer (VideosService) prefers these when present, falling back to
  // thumbnailUrl/thumbnailBlurDataUrl otherwise. coverClipId is a plain id
  // reference, not a real Prisma relation (kept soft/nullable, same
  // treatment as Clip.highlightRank, so a cascade-deleted clip can't leave
  // a dangling required FK). Null for pre-existing rows, videos with no
  // rendered clips yet, or if this best-effort promotion step fails.
  coverClipId               String?
  coverThumbnailUrl         String?
  coverThumbnailBlurDataUrl String?
  // 0-100, real progress reported by import-youtube.worker.ts as yt-dlp
  // downloads the source - same "never fabricated" convention as
  // transcribeProgress below, and deliberately a separate column rather
  // than reusing that one: IMPORTING and (transcribe's) UPLOADED are
  // different stages, and overloading one column for both would make an
  // in-flight value ambiguous about which stage it belongs to. Null before
  // the import job has started or once status has moved past IMPORTING.
  // Reset to 0 at the start of every import attempt (including retries),
  // same reasoning as transcribeProgress.
  importProgress            Int?
  // 0-100, real progress reported by transcribe.worker.ts at each checkpoint
  // (source downloaded, each audio chunk transcribed) - never a fabricated/
  // interpolated animation. Null before the transcribe job has started or
  // once status has moved past UPLOADED (irrelevant at that point - the
  // frontend's per-stage progress bar only reads this while still on the
  // Transcribe stage). Reset to 0 at the start of every transcribe attempt
  // (including retries) so a re-run never shows a stale value from a
  // previous failed attempt.
  transcribeProgress        Int?
  // Chosen once at upload/import time (see TranscriptionProvider above) -
  // never changes afterward, including on retry (VideosService.retry()
  // re-enqueues transcribe with this same value). OPENAI requires an
  // available PremiumCredit to have been consumed by this video first (see
  // premiumCredit below); GROQ needs no payment at all.
  transcriptionProvider     TranscriptionProvider @default(GROQ)
  // Pre-Processing Settings roadmap, Phase 0/1 - the resolved choices from
  // the settings screen shown between file/URL selection and the actual
  // upload/import call (see apps/web/components/processing-settings/), a
  // plain snapshot written once at creation (same "chosen at upload time,
  // never re-resolved" shape as transcriptionProvider above) rather than a
  // live reference to a ProcessingPreset row - a preset is just a
  // convenience bulk-setter into this JSON, same "copy-on-apply" relationship
  // SubtitlePreset/BrandKitTemplate already have to the fields they set.
  // Shape is @speedora/shared's ProcessingOptions. Null for every video
  // created before this column existed - detect-clips.worker.ts/
  // render-clip.worker.ts fall back to their own existing hardcoded
  // defaults when absent, so this is purely additive.
  processingOptions         Json?
  // Speaker Intelligence roadmap, Milestone A (Voice Activity Detection) -
  // the FIRST whole-video intelligence signal stored as its own JSON blob
  // on Video, rather than distributed onto per-TranscriptSegment columns
  // (unlike diarization/vocal-emotion/loudness, which map cleanly onto
  // Whisper's own segment boundaries - see docs/ai/audio.md). VAD's
  // classified timeline (silence/speech/non_speech intervals) does NOT
  // align to segment boundaries - a silence can span multiple segments or
  // fall entirely between them - so it needs its own continuous timeline,
  // same "raw + features" pair convention as Clip's other AI-signal columns
  // (see database.md), just scoped to Video instead of Clip since VAD runs
  // once per video (same scope as diarizeSpeakers), not once per rendered
  // clip. Both null until detectVoiceActivity has run for this video, or
  // when it fails (never fails the transcribe job - same "optional signal"
  // fallback as diarization/vocal-emotion above).
  voiceActivitySegments     Json?
  voiceActivityFeatures     Json?
  // Speaker Intelligence roadmap, Milestone B (Turn/Silence/Overlap
  // Detection) - @speedora/speaker-diarization's deriveDiarizationFeatures()
  // output (speakerCount, per-turn segments, per-speaker total duration,
  // turnCount/switchCount, overlappingSpeech, silences), computed once per
  // video from diarizeSpeakers()'s own raw turn list right after diarization
  // runs (that list was previously discarded once assignSpeakerLabels
  // mapped it onto TranscriptSegment rows - see docs/ai/audio.md). Null
  // when diarization itself never produced any turns (no
  // HUGGINGFACE_TOKEN, gated-model rejection, or genuine detection
  // failure) - same "optional signal" fallback as voiceActivitySegments.
  diarizationFeatures       Json?
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt
  // Sprint 5A (Collaboration Foundation) - every Video belongs to exactly
  // one Workspace (nullable only transiently during the backfill
  // migration - see the migration's own README; schema.prisma always
  // reflects the target/final state, not the intermediate one). ownerId
  // above is retained unchanged as "who uploaded this" - access control
  // now reads workspaceId + the requester's WorkspaceMembership role
  // instead, see apps/api/src/workspace/workspace-access.service.ts.
  // projectId/folderId are optional - a video can live directly in a
  // Workspace with no Project, matching Figma's "files can live outside
  // any project" behavior. folderId implies projectId is also set,
  // enforced at the service layer (Folder always belongs to one Project).
  workspaceId               String
  workspace                 Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId                 String?
  project                   Project?              @relation(fields: [projectId], references: [id], onDelete: SetNull)
  folderId                  String?
  folder                    Folder?               @relation(fields: [folderId], references: [id], onDelete: SetNull)

  transcriptSegments  TranscriptSegment[]
  translationRequests TranscriptTranslationRequest[]
  clips               Clip[]
  premiumCredit       PremiumCredit?
  statusEvents        VideoStatusEvent[]
  exportJobs          ExportJob[]
  shareLinks          ShareLink[]
  comments            Comment[]
  approvals           Approval[]

  @@index([ownerId])
  @@index([workspaceId])
  @@index([projectId])
  @@index([folderId])
}

// Audit trail for Video.status transitions (Fase 3 - DB+JSON-contract
// roadmap: an explicit history table for the pipeline's long-running job,
// rather than only ever seeing the current status). One row per transition.
// There's no separate "fromStatus" column - transitions for one video are
// always sequential (never processed by two workers concurrently), so the
// previous status is simply the prior row's toStatus when read ordered by
// createdAt, and storing it again would just be redundant with that
// ordering. Written exclusively by @speedora/database's updateVideoStatus()/
// recordVideoStatusEvent() helpers - see CLAUDE.md's Fase 3 section and
// ARCHITECTURE.md.
model VideoStatusEvent {
  id           String      @id @default(cuid())
  videoId      String
  video        Video       @relation(fields: [videoId], references: [id], onDelete: Cascade)
  toStatus     VideoStatus
  // Only set when toStatus is FAILED - the caught error's message, so a
  // failure can be diagnosed from a DB query alone without needing Sentry
  // access. Message text only (never the full error object/stack), same
  // "tags only" discipline already used at these call sites'
  // Sentry.captureException calls.
  errorMessage String?
  createdAt    DateTime    @default(now())

  @@index([videoId, createdAt])
}

// One row per timestamped line from the transcribe (Whisper) job.
// A clip's transcript is derived by querying segments within its time range,
// rather than duplicating segment data per clip.
model TranscriptSegment {
  id                         String   @id @default(cuid())
  videoId                    String
  video                      Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  start                      Float
  end                        Float
  text                       String
  speaker                    String?
  // Top-1 label from a vocal (audio-based) emotion classifier - one of
  // "neu"/"hap"/"ang"/"sad" (superb/wav2vec2-base-superb-er's IEMOCAP
  // taxonomy - see CLAUDE.md's "Vocal Emotion Detection" section for why
  // this is a deliberately narrow, explicitly-heuristic signal, not a
  // trained/calibrated prediction). Null for segments too short to classify
  // meaningfully, or when detection wasn't run/failed for this video.
  emotion                    String?
  // Array of {word, start, end} (absolute seconds, same clock as start/end
  // above) from Whisper's word-level timestamp_granularities - null for
  // segments transcribed before this field existed (Fase 3 pasca-MVP; not
  // backfilled, see CLAUDE.md). A null/empty value here just means the
  // karaoke caption preset can't sync to this segment - render-clip falls
  // back to plain text for it rather than failing.
  words                      Json?
  // Fase 25 (Audio Intelligence, Phase A of the AI Fusion roadmap) - mean
  // RMS/peak level in dB over this segment's own audio slice (see
  // @speedora/audio-intelligence's analyzeAudioLoudness), computed via
  // ffmpeg's astats filter on the same full-track audio file diarization/
  // vocal-emotion already extract. Null for the same reasons emotion can be
  // null: detection wasn't run/failed for this video, or the slice was too
  // short/silent for ffmpeg to report a meaningful reading. Absolute dB
  // values are NOT calibrated/comparable across different source
  // recordings - only meaningful relative to other segments of the SAME
  // video.
  rmsDb                      Float?
  peakDb                     Float?
  // Words per second within this segment - pure math from Whisper's own
  // segment boundaries + word count, no audio analysis involved at all
  // (see @speedora/audio-intelligence's computeSpeakingRate). Null only
  // when this segment has no word-level data (see `words` above).
  speakingRateWordsPerSecond Float?
  // Subtitle Studio roadmap (P2f) - sparse map of languageCode -> translated
  // text, populated one language at a time via POST /videos/:id/transcript-
  // segments/translate (batched one LLM call per video per language, not
  // per segment). Null/missing key means that language hasn't been
  // requested yet for this segment - never backfilled proactively.
  translations               Json?
  createdAt                  DateTime @default(now())

  @@index([videoId])
}

// Subtitle Studio roadmap (P2f) - one row per translate request, append-
// only (never updated/deleted) - same "row IS the rate-limit counter"
// pattern as ClipPlatformCopy (Publishing Expansion Phase 7B), rather than
// stretching AuditLogEntry's "selective, workspace-significant actions"
// semantics to also serve as a quota tracker. No status column (unlike
// ClipPlatformCopy) - the outcome lives on each TranscriptSegment's own
// `translations` field, not here; this table exists purely to answer
// "how many times has this user requested a translation in the last 24h."
model TranscriptTranslationRequest {
  id           String   @id @default(cuid())
  videoId      String
  video        Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  requestedBy  String
  languageCode String
  createdAt    DateTime @default(now())

  @@index([requestedBy, createdAt])
  @@index([videoId])
}

// Natural Language AI Search roadmap (P4) - same "row IS the rate-limit
// counter" pattern as TranscriptTranslationRequest above, not tied to a
// specific video (a search query isn't scoped to one video the way a
// translate request is) - counts a user's parse-query calls in a rolling
// 24h window. No status/result column - the parsed filters are returned
// directly in the HTTP response, never persisted; this table exists purely
// to answer "how many times has this user asked for an AI search in the
// last 24h."
model AiSearchRequest {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  query     String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// One row per candidate produced by the detect-clips job; outputUrl is set
// once the render-clip job finishes.
model Clip {
  id                          String       @id @default(cuid())
  videoId                     String
  video                       Video        @relation(fields: [videoId], references: [id], onDelete: Cascade)
  startTime                   Float
  endTime                     Float
  viralityScore               Float
  outputUrl                   String?
  // Bytes of the rendered output in object storage - set alongside
  // outputUrl by render-clip.worker.ts via an fs.stat() of the rendered
  // file, right next to the existing computeFileMd5Hex() stream-based hash
  // (both read the same on-disk file before it's uploaded). Feeds the
  // Dashboard's per-owner "Storage Used" stat - see Video.sourceSizeBytes.
  // Null until the clip finishes rendering, or for pre-existing rows.
  outputSizeBytes             Int?
  // Object storage key for a single extracted thumbnail frame
  // (thumbnails/<id>.webp - .jpg for pre-Phase-2 rows, see Video.thumbnailUrl's
  // own comment), set by render-clip.worker.ts (best-effort) from the midpoint
  // of the RENDERED output - not the raw source - so the thumbnail matches
  // exactly what the viewer will see (crop/captions/B-roll already burned in).
  // Same "never exposed as a raw key" treatment as Video.thumbnailUrl above -
  // ClipsService.toDto()/VideosService.mapVideoWithClips compute a
  // `/clips/:id/thumbnail` endpoint path instead. Null until the clip
  // finishes rendering, extraction fails, or for pre-existing rows.
  thumbnailUrl                String?
  // Phase 2 (image optimization roadmap) - same tiny base64 blur-placeholder
  // treatment as Video.thumbnailBlurDataUrl above, inlined in the clip DTO.
  thumbnailBlurDataUrl        String?
  // Phase 3 (Hover Preview/Storyboard roadmap) - same treatment as
  // Video.storyboardFrameUrls above, extracted from the RENDERED output by
  // render-clip.worker.ts (same reasoning as thumbnailUrl - matches exactly
  // what the viewer sees).
  storyboardFrameUrls         Json?
  // Phase 3 (Animated Thumbnail roadmap) - same treatment as
  // Video.animatedThumbnailUrl above, extracted from the RENDERED output by
  // render-clip.worker.ts (same reasoning as thumbnailUrl - matches exactly
  // what the viewer sees).
  animatedThumbnailUrl        String?
  // Phase 3 (Hover Preview roadmap, "Clip Preview" on a clip card) - same
  // treatment as Video.hoverPreviewUrl above, extracted from the RENDERED
  // output by render-clip.worker.ts.
  hoverPreviewUrl             String?
  // Phase 4 of the thumbnail roadmap (AI Thumbnail Selection, Level 2) -
  // @speedora/thumbnail-selection's chosen in-clip timestamp (replacing the
  // naive (endTime - startTime) / 2 midpoint thumbnailUrl/
  // thumbnailBlurDataUrl above are extracted at), plus its explainability
  // breakdown. Deliberately NOT used to pick which clip is a video's cover -
  // see @speedora/contracts' thumbnail-selection.ts for the Level 1 vs.
  // Level 2 policy this column must never violate; that's highlightScore/
  // highlightRank's job. Null for pre-existing rows and if the render graph
  // hasn't run yet.
  thumbnailSelectionTimestamp Float?
  thumbnailSelectionBreakdown Json?
  thumbnailSelectionFallback  String?
  thumbnailSelectionReason    String?
  captionStyle                CaptionStyle @default(DEFAULT)
  // Subtitle Studio roadmap (P2c) - orthogonal to captionStyle (composes
  // with any preset) rather than new CaptionStyle enum values, to avoid a
  // combinatorial DEFAULT/DEFAULT_SPEAKER_COLOR/KARAOKE_SPEAKER_COLOR/...
  // explosion. False by default - existing clips render unchanged.
  speakerColorCaptions        Boolean      @default(false)
  // AI Intelligence v4 Track B, Phase A2 (Subtitle Rewriter render wiring -
  // see docs/ai/subtitle-intelligence.md, ADR DB5/DB10) - opts this clip's
  // captions into subtitleIntelligence's structural re-chunking, orthogonal
  // to captionStyle (same reasoning as speakerColorCaptions above). False
  // by default - existing clips render unchanged. Also requires the global
  // SUBTITLE_REWRITE_ENABLED flag and is skipped whenever captionLanguage
  // is set (a translation) - see render-clip.worker.ts's own comment.
  smartSegmentation           Boolean      @default(false)
  // AI Intelligence v4 Track B, Phase B2 (Dynamic Caption Engine render
  // wiring - see docs/ai/subtitle-intelligence.md, ADR DB11) - opts this
  // clip's captions into captionTreatment's per-line size/animation
  // treatment, orthogonal to captionStyle (same reasoning as
  // smartSegmentation above). False by default - existing clips render
  // unchanged. Can only actually apply when smartSegmentation is ALSO on
  // for a given render (dynamic captions have no meaning without
  // subtitleIntelligence's own lines) - see render-clip.worker.ts's own
  // comment.
  dynamicCaptions             Boolean      @default(false)
  // Subtitle Studio roadmap (P2f) - which key of each TranscriptSegment's
  // `translations` map to burn in; null/absent means the original
  // (untranslated) text, same as every existing clip today.
  captionLanguage             String?
  // Brand Kit roadmap (P3a) - gates whether render-enqueue time (ClipsService
  // .render()/.update(), and detect-clips.worker.ts's initial auto-render)
  // pulls the video owner's Brand Kit (font now; logo/watermark/intro/outro
  // in later P3 sub-phases) into RenderClipJobData at all. True by default -
  // same "AI/branding gives a good default, user opts out per clip rather
  // than opting in every time" posture this product already follows
  // elsewhere (see the P3 plan's own rationale). Added once here, ahead of
  // watermark/intro/outro actually needing it, rather than retrofitting a
  // migration per sub-phase.
  applyBrandKit               Boolean      @default(true)
  // Subtitle Presets roadmap (P3b) - per-clip override of the resolved
  // caption font, same nullable-override shape as captionLanguage above.
  // Null means "no override" - render-enqueue time falls back to
  // applyBrandKit/User.brandFontFamily (see ClipsService.resolveFontFamily's
  // precedence), same as before this column existed. A non-null value here
  // always wins, regardless of applyBrandKit - an explicit per-clip choice
  // (e.g. picking a Subtitle Preset) is a deliberate override, not a brand
  // default the user might not have meant to touch.
  fontFamily                  String?
  // Watermark roadmap (P3c) - per-clip on/off gate for the owner's Brand Kit
  // watermark, same shape as applyBrandKit (a per-clip boolean opt-out, not
  // a full per-clip watermark asset/opacity/position override) - composable
  // with applyBrandKit: a clip can use the Brand Kit's font while skipping
  // its watermark, or vice versa. True by default, same "brand gives a good
  // default, user opts out per clip" posture as applyBrandKit.
  watermarkEnabled            Boolean      @default(true)
  // Intro roadmap (P3d) - per-clip on/off gate for the owner's Brand Kit
  // intro, same shape/reasoning as watermarkEnabled - composable with it and
  // applyBrandKit independently.
  introEnabled                Boolean      @default(true)
  // Outro roadmap (P3e) - per-clip on/off gate, same shape as introEnabled.
  outroEnabled                Boolean      @default(true)
  // Suggested 3-second-opener hook line and social hashtags (without a
  // leading '#') from the same detect-clips LLM call that scores virality -
  // not baked into the rendered video, purely metadata for the
  // gallery/editor. hookText is nullable (the LLM call can fail/return
  // nothing without failing the whole job - see detectCandidates() in
  // detect-clips.worker.ts); hashtags defaults to an empty array rather
  // than nullable so callers never have to null-check it.
  hookText                    String?
  hashtags                    String[]     @default([])
  // Fase 8 (Content Intelligence) - same detect-clips LLM call as
  // viralityScore/hookText/hashtags above, extended with a multi-metric
  // breakdown and explainable-AI reasoning instead of one opaque number.
  // `scores` is one JSON blob (like TranscriptSegment.words) rather than a
  // column per metric - always read/written as a unit, and a future metric
  // addition doesn't need its own migration. Shape: { hookStrength,
  // educationalValue, curiosity, emotion, storytelling, novelty,
  // trustAuthority }, each 0-100 - see packages/shared's ClipScores.
  scores                      Json?
  // 1-2 sentence explanation of why this clip was picked - the
  // "explainable AI" requirement: a user should never have to take
  // viralityScore on faith.
  reason                      String?
  topics                      String[]     @default([])
  keywords                    String[]     @default([])
  // e.g. "educate" | "entertain" | "persuade" | "inspire" | "story" | "other" -
  // free-form string, not a Postgres enum, since this is an LLM-classified
  // label (see CaptionStyle vs. this: CaptionStyle is a fixed, code-driven
  // set of render presets, this is open-ended content classification that
  // may need new values without a schema migration).
  intent                      String?
  // Call-to-action text detected in the clip, if any (e.g. "follow for
  // part 2", "link in bio") - null/empty when the clip has none.
  ctaText                     String?
  // Fase 23 (DB+JSON-contract roadmap, Fase 4 - new feature built purely via
  // the checklist) - deterministic keyword-pattern suggestions (see
  // @speedora/emoji-suggester), computed from this clip's own transcript
  // text at detect-clips time. Purely metadata (like hookText/hashtags),
  // never burned into the rendered video - defaults to an empty array
  // rather than nullable so callers never have to null-check it.
  emojiSuggestions            String[]     @default([])
  // Fase 26 (Scene Intelligence, AI Fusion roadmap Phase B) - clip-relative
  // (0 = clip start) timestamps of detected hard shot/scene cuts within
  // this clip, from @speedora/scene-intelligence's ffmpeg-based detector.
  // Empty array (not null) when analysis found no cuts or failed to run -
  // same "always an array" convention as topics/keywords/emojiSuggestions.
  sceneCuts                   Float[]      @default([])
  // Batch SC-1 (Scene Intelligence taxonomy expansion, on top of Fase 26) -
  // one JSON array of @speedora/scene-intelligence's classifySceneCutTypes()
  // output ({t, type: 'hard_cut'|'fade'|'dissolve'}[], clip-relative
  // seconds, one entry per `sceneCuts` timestamp above) - a second ffmpeg
  // pass (blackdetect) over the same cuts, not a re-detection. Null (not an
  // empty array) when classification wasn't run or failed entirely for the
  // clip, distinct from an empty array (no cuts to classify at all) - same
  // convention as facialEmotions below.
  sceneCutEvents              Json?
  // Batch SC-2 (Scene Intelligence taxonomy expansion, continuing Batch
  // SC-1) - one JSON array of @speedora/scene-intelligence's
  // analyzeMotionEnergy() output ({t, motionEnergy}[], clip-relative
  // seconds, ~1 sample/second) - a SEPARATE signal from sceneCuts/
  // sceneCutEvents above (motion magnitude, not cut events). Json (not
  // Float[] like sceneCuts) because each sample is a {t, motionEnergy}
  // pair, not a bare number. Defaults to an empty JSON array (never null) -
  // analyzeMotionEnergy() itself never fails the job, same "always an
  // array" convention as sceneCuts.
  motionEnergy                Json         @default("[]")
  // Batch SC-2 - derived summary (see audioFeatures/sceneFeatures below) -
  // always computed (deriveMotionEnergyFeatures() never returns null, only
  // all-null fields for an empty `motionEnergy`), same "always populated"
  // convention as sceneFeatures/audioFeatures despite the nullable column
  // type (Prisma Json columns are declared nullable here purely so the
  // adapter isn't forced to fabricate a value before the first render).
  motionEnergyFeatures        Json?
  // Batch SC-3 (Scene Intelligence taxonomy expansion, continuing Batch
  // SC-1/SC-2) - one JSON array of @speedora/scene-intelligence's
  // detectCameraMotion() output ({t, dx, dy, scale, rotation, ecc}[],
  // clip-relative seconds, ~1 sample/second) - a Python/OpenCV subprocess
  // (ECC image alignment), unlike sceneCuts/motionEnergy above (both
  // ffmpeg-based). Null (not an empty array) when the analysis wasn't run
  // or failed entirely for the clip, same convention as facialEmotions
  // below (distinct from sceneCuts/motionEnergy's "always an array"
  // convention, which only applies to ffmpeg-based detectors that catch
  // their own failures).
  cameraMotion                Json?
  // Batch SC-3 - derived summary (see motionEnergyFeatures above) - null
  // exactly when `cameraMotion` above is null, same convention as
  // facialFeatures/gestureFeatures.
  cameraMotionFeatures        Json?
  // Taxonomy category F (Editing Rhythm, requested by user after Batch
  // SC-3) - @speedora/editing-rhythm's deriveEditingRhythmFeatures()
  // output (tempoScore/pacingScore/accelerationScore). NO separate "raw"
  // column - unlike every signal above, this one is a COMPOSITE (its input
  // is OTHER signals' already-computed sceneCuts/motionEnergy/features,
  // not a fresh subprocess/ffmpeg detector of its own), so there's no
  // independent raw timeline to persist here; the raw data it's built from
  // already lives in Clip.sceneCuts/Clip.motionEnergy. Always computed
  // when render-clip runs (never null in practice), same "always populated
  // despite a nullable column type" convention as sceneFeatures/
  // audioFeatures above.
  editingRhythmFeatures       Json?
  // Fase 27 (Facial Intelligence, AI Fusion roadmap Phase C) - one JSON
  // array of @speedora/facial-intelligence's per-sample output ({t, emotion,
  // score}[], clip-relative seconds), same "one JSON blob, not a column per
  // field" reasoning as `scores` above - always read/written as a unit.
  // Null (not an empty array) when the analysis wasn't run or failed
  // entirely for the clip - distinct from a sample within the array having
  // emotion/score null (no face found in that one sampled frame).
  facialEmotions              Json?
  // Fase 28 (Mini Fusion Engine v1 prep, AI Fusion roadmap Checkpoint 1) -
  // dense derived summaries per signal (see packages/contracts/src/
  // intelligence-signal.ts's raw/features convention and each module's own
  // deriveXFeatures()), separate from the raw timelines above
  // (sceneCuts/facialEmotions) and from TranscriptSegment's raw
  // rmsDb/peakDb/speakingRateWordsPerSecond columns (Fase 25) - the Fusion
  // Engine reads only these three columns, never the raw data directly.
  // Null when the underlying raw signal itself is empty/unavailable for
  // this clip (nothing to derive a summary from), not a fabricated
  // all-zero object.
  audioFeatures               Json?
  sceneFeatures               Json?
  facialFeatures              Json?
  // Fase 29/31 (Mini Fusion Engine v1 -> v2, AI Fusion roadmap - extends
  // Checkpoint 1/2) - @speedora/fusion-engine's computeHighlightScore()
  // output, computed from whichever of audioFeatures/sceneFeatures/
  // facialFeatures/gestureFeatures below are available for this clip.
  // `highlightScore` null means the sum of WEIGHTED signal contributions
  // was zero (not a fabricated 0/50) - a signal can be present in
  // `highlightBreakdown` with real data yet still not move this number if
  // its configured weight is 0 (e.g. gesture currently - see
  // @speedora/fusion-engine's weights.ts). `highlightBreakdown` (Json) now
  // holds FusionOutput's full per-FEATURE `contributions` array (v2:
  // feature-level, not one opaque sub-score per signal - see
  // packages/contracts/src/fusion.ts), `highlightExplainability` (Json)
  // holds the structured `topFactors`, `highlightConfidence` (0-1) is a
  // heuristic coverage+quality estimate (NOT a calibrated probability), and
  // `highlightReason` stays the human-readable sentence - same
  // "explainable AI" requirement as Fase 8's `reason`. All four are always
  // populated once computeHighlightScore runs, even when highlightScore
  // itself ends up null.
  highlightScore              Float?
  highlightBreakdown          Json?
  highlightExplainability     Json?
  highlightConfidence         Float?
  highlightReason             String?
  // Rank among sibling clips of the same video by highlightScore, computed
  // once by @speedora/fusion-engine's rankClips() after every clip in the
  // video has finished rendering (see render-clip.worker.ts) - null until
  // then, and for videos with only one clip this is still populated (rank
  // 1) once that one clip is done, for consistency.
  highlightRank               Int?
  // Fase 30 (Gesture Intelligence, AI Fusion roadmap Checkpoint 2) - same
  // raw/features split as Scene/Facial Intelligence (Fase 26/28):
  // @speedora/gesture-intelligence's per-sample output ({t, gesture,
  // confidence}[], clip-relative seconds) and its derived summary
  // ({dominantGesture, gestureTransitions, peakConfidence, stability}).
  // gestures null (not []) when the whole analysis failed to run;
  // gestureFeatures null exactly when gestures is null.
  gestures                    Json?
  gestureFeatures             Json?
  // Fase 32 (Mini Fusion Engine v2's 'llm' signal + Prediction/
  // Recommendation stages) - llmFeatures is the SAME object as `scores`
  // above (Fase 8's ClipScores), just snapshotted at render-clip time as
  // what was actually fed into computeHighlightScore - no separate
  // derivation step, unlike audio/scene/facial/gesture's *Features
  // columns, since ClipScores is already a per-clip Features-shaped object
  // (see @speedora/fusion-engine's feature-pipeline.ts). Null when the
  // clip had no scores at all (detect-clips' LLM call never ran/failed).
  // highlightPrediction/highlightRecommendation are computeHighlightScore's
  // own Prediction/Recommendation stage output - always populated once it
  // runs, same as highlightBreakdown/highlightExplainability/highlightReason.
  llmFeatures                 Json?
  highlightPrediction         Json?
  highlightRecommendation     Json?
  // AI Fusion roadmap's Face Intelligence initiative, Batch 1 - same raw/
  // features split as Scene/Facial/Gesture Intelligence above:
  // @speedora/facial-intelligence's detectFaceLandmarks() per-sample output
  // (MediaPipe FaceLandmarker: blendshapes/rotation/boundingBox/iris/eye-
  // corner points per sampled frame) and its derived summary (blinkRate,
  // averageSmile, averageMouthOpen, averageAbsoluteYaw/Pitch, position/
  // size/visibilityScore). Distinct from facialEmotions/facialFeatures
  // above (a separate subprocess/model producing an unrelated feature set -
  // expression classification vs. landmark geometry). faceLandmarks null
  // (not []) when the whole analysis failed to run; faceLandmarkFeatures
  // null exactly when faceLandmarks is null.
  faceLandmarks               Json?
  faceLandmarkFeatures        Json?
  // AI Fusion roadmap's Face Intelligence initiative, Batch 4.5 (Quality
  // Metrics & Telemetry) - explicitly NOT a scoring signal (user's own
  // framing: "bukan menambah AI baru"). Purely explainability/audit
  // telemetry over Batch 4's tracker (fragmentation rate, id switch count,
  // lost-track duration, re-identification success rate, per-track
  // breakdown, etc. - see @speedora/facial-intelligence's
  // deriveTrackingQualityMetrics). Not consumed by @speedora/fusion-engine
  // at all, unlike every other *Features column above. Null when
  // faceLandmarks itself is null (nothing to derive telemetry from).
  trackingQualityMetrics      Json?
  // Speaker Intelligence roadmap, Milestone A - Active Speaker Detection,
  // Speaker-Face Association, Lip Sync Verification
  // (@speedora/active-speaker-intelligence). All three are pure
  // aggregations over faceLandmarks + this clip's own transcript segments'
  // audio timing (no new subprocess) - see docs/ai/speaker-intelligence.md.
  // Not yet consumed by @speedora/fusion-engine (same "collect first,
  // calibrate later" treatment editingRhythm/gesture/faceGeometry got
  // before they were wired in - see ai/fusion.md). Null when faceLandmarks
  // itself is null (nothing to derive these from).
  activeSpeakerSamples        Json?
  speakerFaceAssociations     Json?
  lipSyncVerifications        Json?
  // Speaker Intelligence roadmap, Milestone B - @speedora/speaker-diarization's
  // buildSpeakerTimeline()/detectSpeakerTransitions() output, fusing this
  // clip's own transcript-derived speaker turns with the Milestone A
  // signals just above (speakerFaceAssociations/activeSpeakerSamples) into
  // one unified per-clip timeline. Null when there are no speaker turns
  // covering this clip's time range at all (diarization never ran/found
  // nothing here) - not a fabricated empty timeline.
  speakerTimeline             Json?
  speakerTimelineFeatures     Json?
  // Speaker Intelligence roadmap, Milestone C - @speedora/speaker-scoring's
  // deriveClipSpeakerScores() output: one entry per speaker in this clip's
  // speakerTimeline for confidence/engagement/importance, one entry per
  // timeline turn for highlightMoments (a speaker turn IS the moment
  // boundary - see that package's own comments). Re-runs
  // deriveFaceLandmarkFeatures/deriveAudioFeatures scoped to each
  // speaker's own face track/transcript segments - not a new raw signal,
  // a re-aggregation of faceLandmarks/audioFeatures/gestureFeatures/
  // speakerTimeline above. Null when speakerTimeline itself is null
  // (nothing to score).
  speakerConfidenceScores     Json?
  speakerEngagementScores     Json?
  speakerImportanceScores     Json?
  speakerHighlightMoments     Json?
  // AI Fusion roadmap's OCR initiative, Batch OCR-1 - @speedora/ocr-
  // intelligence's detectOcrText() per-sample output (Tesseract: text +
  // bounding box + confidence per detected on-screen text region, per
  // sampled frame). Raw only - no `ocrFeatures` companion column yet,
  // unlike every other detector's Batch 1: OCR-2 (cross-frame tracking +
  // rule-based Subtitle/Slide/Caption/Logo/Price/Name classification) is
  // what a derived-features summary would even mean here, so it's added
  // in that batch instead of as a premature placeholder now. Null (not
  // []) when the whole analysis failed to run.
  ocrText                     Json?
  // AI Fusion roadmap's OCR initiative, Batch OCR-2 - the "store
  // everything" layer between raw (ocrText) and aggregate (ocrFeatures):
  // @speedora/ocr-intelligence's trackOcrText()+classifyOcrTrack() output,
  // one entry per tracked on-screen text element across its lifetime, each
  // carrying every feature (position/size/duration/persistence/motion/
  // nearFace/regexFlags) PLUS the rule-fusion category/categoryConfidence
  // - user's own instruction: persist all of this now so a future trained
  // classifier could be built from it later. ocrFeatures is the dense
  // per-clip summary computeHighlightScore actually consumes (derived FROM
  // ocrTracks, same "raw/features" relationship as every other module's
  // pair, with this extra middle layer specific to OCR's multi-region-
  // per-frame shape). Both null exactly when ocrText is null.
  ocrTracks                   Json?
  ocrFeatures                 Json?
  // Object Intelligence roadmap, Batch OI-1 (Foundation) -
  // @speedora/object-intelligence's detectObjects() per-sample output
  // (MediaPipe Object Detector/EfficientDet-Lite0: category + bounding box
  // + confidence per detected entity, per sampled frame - a frame can have
  // multiple simultaneous objects, same multi-region-per-frame shape as
  // ocrText). Null (not []) when the whole analysis failed to run.
  objects                     Json?
  // The "store everything" layer between raw (objects) and aggregate
  // (objectFeatures): @speedora/object-intelligence's trackObjects()
  // output, one entry per tracked object across its lifetime (category,
  // averaged position/size/confidence, start/end time, appearsFrames,
  // persistenceScore) - same three-layer "raw/tracks/features" pattern as
  // ocrText/ocrTracks/ocrFeatures, generalized to a genuine multi-object
  // tracker (see track-objects.ts's own module comment for why OCR's
  // tracker, not Face Intelligence's single-track one, is the right
  // precedent). objectFeatures is the dense per-clip summary
  // computeHighlightScore actually consumes, derived FROM objectTracks.
  // Both null exactly when objects is null.
  objectTracks                Json?
  objectFeatures              Json?
  // Composition Intelligence roadmap, Batch RB-1/RB-2 (see docs/ai/
  // composition-intelligence.md) - @speedora/composition-intelligence's
  // deriveCompositionFeatures() output (ruleOfThirdsScore/headroomScore/
  // leadRoomScore/centeringScore/subjectLossRatio/compositionStability/
  // framingConsistency). NO separate "raw" column - same COMPOSITE
  // reasoning as editingRhythmFeatures above: its input is @speedora/
  // primary-subject's already-selected per-instant subject boxes (built
  // FROM Facial/Active-Speaker/Object Intelligence's already-computed
  // faceLandmarks/activeSpeakerSamples/objectTracks columns above, not a
  // fresh detector of its own), so there's no independent raw timeline to
  // persist here. Null when there were zero usable primary-subject samples
  // for this clip (not a fabricated all-null features object).
  compositionFeatures         Json?
  // AI Intelligence v4, Phase 1 (Hook Prediction Engine - see docs/ai/
  // intelligence-v4.md). @speedora/hook-prediction's HookPredictionOutput -
  // hookProbability/reason/confidence/linguisticFeatures/predictionFeatures,
  // read/written as one unit (same "one JSON blob per signal" convention as
  // llmFeatures/highlightBreakdown above). Computed on every render
  // regardless of the HOOK_PREDICTION_ENABLED flag (the flag gates API
  // exposure, not computation - see isHookPredictionEnabled()); null only
  // when the render-graph node's own LLM call failed (optional: true,
  // fallback: null - never fails the render job).
  hookPrediction              Json?
  // AI Intelligence v4, Phase 2 (Semantic Event Detection - see docs/ai/
  // intelligence-v4.md). @speedora/semantic-events' SemanticEvent[] -
  // narrative events (confession/mistake/failure/... 22-value taxonomy)
  // with confidence/importance/evidence/reason. Same array-vs-null
  // convention as sceneCutEvents: null when the render-graph node's own
  // LLM call failed/never ran (optional: true, fallback: null); an empty
  // array means it ran and genuinely found zero events, a real result, not
  // a failure. Computed on every render regardless of the
  // SEMANTIC_EVENT_DETECTION_ENABLED flag (gates API exposure only - see
  // isSemanticEventDetectionEnabled()).
  semanticEvents              Json?
  // AI Intelligence v4, Phase 3 (Narrative Graph - see docs/ai/
  // intelligence-v4.md). @speedora/narrative-graph's NarrativeGraph -
  // segments (hook/setup/context/problem/conflict/escalation/peak/
  // resolution/takeaway/cta) plus relations (leads_to/resolves) between
  // them. Null when the render-graph node's own LLM call failed/never ran
  // (optional: true, fallback: null); a PRESENT object - including the
  // `{ segments: [], relations: [], unsegmented: true }` case, when the
  // clip genuinely doesn't decompose into this taxonomy - means it ran
  // successfully, a real result, not a failure. Computed on every render
  // regardless of the NARRATIVE_GRAPH_ENABLED flag (gates API exposure
  // only - see isNarrativeGraphEnabled()).
  narrativeGraph              Json?
  // AI Intelligence v4, Phase 4 (Contextual Momentum - see docs/ai/
  // intelligence-v4.md). @speedora/contextual-momentum's MomentumCurve - a
  // per-instant timeline of RELATIVE (within-clip-only) momentum scores,
  // composed from already-computed motionEnergy/cameraMotion/
  // editingRhythmFeatures/narrativeGraph signals via a pure computation, no
  // LLM call. Unlike Phases 1-3, this node can't fail in the "LLM call
  // failed" sense (optional: false, no fallback) - null here can only mean
  // this Clip row predates this phase's migration; once computed, the
  // value is always a real array (possibly empty, same "empty array from
  // an optional upstream detector" convention motionEnergy itself already
  // has). Computed on every render regardless of the
  // CONTEXTUAL_MOMENTUM_ENABLED flag (gates API exposure only - see
  // isContextualMomentumEnabled()).
  contextualMomentum          Json?
  // AI Intelligence v4, Phase 5 (Emotional Arc - see docs/ai/
  // intelligence-v4.md). @speedora/emotional-arc's EmotionalArc - a
  // per-segment timeline of RELATIVE (within-clip-only) emotional
  // intensity, composed from already-persisted TranscriptSegment.emotion
  // labels plus Phase 2's semanticEvents as optional context via a pure
  // computation, no LLM call. Same null-semantics as contextualMomentum
  // (not Phases 1-3's): this node can't fail in the "LLM call failed"
  // sense (optional: false, no fallback) - null here can only mean this
  // Clip row predates this phase's migration; once computed, the value is
  // always a real array (possibly empty, if the clip has no transcript
  // segments). Computed on every render regardless of the
  // EMOTIONAL_ARC_ENABLED flag (gates API exposure only - see
  // isEmotionalArcEnabled()).
  emotionalArc                Json?
  // AI Intelligence v4, Phase 6 (Multi-speaker Reasoning - see docs/ai/
  // intelligence-v4.md). @speedora/multi-speaker-reasoning's
  // MultiSpeakerBreakdown - a per-speaker attribution of Phase 4's
  // MomentumCurve and Phase 5's EmotionalArc via Speaker Intelligence's
  // SpeakerTimelineEntry[], via a pure computation, no LLM call. Null
  // semantics are a THIRD pattern, different from both established ones:
  // null means EITHER "this row predates the migration" (Phase 4/5's
  // meaning) OR "this clip doesn't have 2+ distinct speakers" (this
  // module's own genuine, by-design result for the majority
  // single-speaker case - see computeMultiSpeakerBreakdown()'s own doc
  // comment) - the two are not distinguished at the column level, same as
  // cameraMotion/sceneCutEvents not distinguishing "didn't run" from "ran
  // and found nothing." Computed on every render regardless of the
  // MULTI_SPEAKER_REASONING_ENABLED flag (gates API exposure only - see
  // isMultiSpeakerReasoningEnabled()).
  multiSpeakerBreakdown       Json?
  // AI Intelligence v4, Phase 7 (Cross-module Fusion, spec Part 4 -
  // Virality Engine - see docs/ai/intelligence-v4.md). @speedora/
  // virality-engine's ViralityPrediction - 8 heuristic sub-probabilities +
  // one composite estimate, fused from Phase 1's HookPredictionOutput,
  // Phase 3's NarrativeGraph, Phase 4's MomentumCurve, and Phase 5's
  // EmotionalArc via a pure computation, no LLM call. DELIBERATELY
  // DISTINCT from Clip.viralityScore (Fase 8's original MVP LLM
  // clip-scoring, a single 0-100 number used to SELECT candidate moments
  // before render) - see docs/ai/scoring.md, which documents this as the
  // 4th of 4 distinct scoring systems in this codebase; do not conflate
  // the two. Same null-semantics as contextualMomentum/emotionalArc (not
  // multiSpeakerBreakdown's third pattern): this node always produces a
  // real object once it runs (there is no "doesn't apply" case the way
  // multi-speaker attribution has for single-speaker clips), so null here
  // can ONLY mean this Clip row predates this phase's migration. Computed
  // on every render regardless of the VIRALITY_ENGINE_ENABLED flag (gates
  // API exposure only - see isViralityEngineEnabled()).
  viralityPrediction          Json?
  // AI Intelligence v4, Phase 10 (Retention Curve Insights, spec Part 5
  // extension - see docs/ai/intelligence-v4.md). @speedora/
  // retention-curve-insights' RetentionCurveInsights - dropPoints/
  // replayZones/emotionalPeaks/curiosityPeaks, each an array of timestamped
  // signal points derived from Phase 4's MomentumCurve, Phase 5's
  // EmotionalArc, and Phase 2's SemanticEvent[] via a pure computation, no
  // LLM call. MomentumCurve/EmotionalArc themselves are unchanged (ADR
  // D13, docs/ai/intelligence-v4.md's Parts 4-15 re-audit) - this is a new
  // additive layer, not a realignment like Phase 9's viralityPrediction.
  // Same null-semantics as contextualMomentum/emotionalArc/
  // viralityPrediction: this node always produces a real object once it
  // runs (each of its 4 array fields can be empty, but the object itself
  // is never null once computed), so null here can ONLY mean this Clip
  // row predates this phase's migration. Computed on every render
  // regardless of the RETENTION_CURVE_INSIGHTS_ENABLED flag (gates API
  // exposure only - see isRetentionCurveInsightsEnabled()).
  retentionCurveInsights      Json?
  // AI Intelligence v4, Phase 11 (Multimodal Reasoning Engine, spec Part 6
  // - see docs/ai/intelligence-v4.md). @speedora/multimodal-reasoning's
  // MultimodalReasoningResult - genuine cross-modal connections
  // (refers_to/co_occurs_with/emphasizes) found across Transcript/Scene/
  // OCR/Face/Gesture/Audio/Speaker evidence (Part 6's own 7 normative
  // modalities) plus Object Intelligence as a documented, non-normative
  // extension, grounded against fabricated evidence citations by a
  // deterministic post-LLM validation step. Same null-semantics as
  // hookPrediction/semanticEvents/narrativeGraph (Phase 1-3's own
  // "?? Prisma.JsonNull" pattern) - this node is LLM-backed (optional:
  // true, fallback: null) and can genuinely fail/never run, unlike
  // retentionCurveInsights/viralityPrediction above. Computed on every
  // render regardless of the MULTIMODAL_REASONING_ENABLED flag (gates API
  // exposure only - see isMultimodalReasoningEnabled()).
  multimodalReasoning         Json?
  // AI Intelligence v4 Track B, Phase A1 (Subtitle Rewriter, spec Part 7 -
  // see docs/ai/subtitle-intelligence.md). @speedora/subtitle-rewriter's
  // SubtitleIntelligence - a STRUCTURAL re-chunking of the transcript into
  // short, pause/rhythm/emotion/speaking-speed-aware caption lines with
  // precomputed emphasis (`timeline`), plus a derived `highlights` array of
  // punch-worthy moments for the future Dynamic Caption Engine (Phase
  // B1/B2). ADR DB1 (resolved via AskUserQuestion before implementation):
  // every ASR word/order/word-level-timestamp is carried through
  // completely UNCHANGED - only line grouping and emphasis selection can
  // differ; lexical paraphrase is explicitly out of scope. Via a pure
  // computation, no LLM call. Does NOT yet affect the actual burned-in
  // captions - buildAss()/toSubtitleSegments() are untouched by this phase
  // (Phase A2's job). Same null-semantics as contextualMomentum/
  // emotionalArc/viralityPrediction/retentionCurveInsights (not
  // multiSpeakerBreakdown's third pattern): this node always produces a
  // real object once it runs, so null here can ONLY mean this Clip row
  // predates this phase's migration. Computed on every render regardless
  // of the SUBTITLE_REWRITE_ENABLED flag (gates API exposure only - see
  // isSubtitleRewriteEnabled()).
  subtitleIntelligence        Json?
  // AI Intelligence v4 Track B, Phase B1 (Dynamic Caption Engine, spec
  // Part 8 - data only, see docs/ai/subtitle-intelligence.md).
  // @speedora/dynamic-caption's CaptionTreatmentTimeline - a dense, 1:1-
  // with-subtitleIntelligence.timeline array of {start, end, sizeTier,
  // animation} decisions ("high emotion -> large text, whisper -> small
  // text, shock -> punch animation, question -> attention animation"),
  // rate-limited so animation stays a highlight, not a constant flicker.
  // Via a pure computation over Phase A1's own subtitleIntelligence +
  // Phase 5's emotionalArc, no LLM call. Does NOT yet affect the actual
  // burned-in captions - Phase B2's job. Same null-semantics/always-a-
  // real-array convention as contextualMomentum/emotionalArc: null here
  // can ONLY mean this Clip row predates this phase's migration. Computed
  // on every render regardless of the DYNAMIC_CAPTION_ENABLED flag (gates
  // API exposure only - see isDynamicCaptionEnabled()).
  captionTreatment            Json?
  // AI Intelligence v4 Track B, Phase C1 (Visual Emphasis Engine, spec
  // Part 9 - data only, see docs/ai/visual-emphasis-engine.md).
  // @speedora/visual-emphasis's EditingSuggestionTimeline - a chronological
  // list of heuristic {technique, start, end, score, reason} entries (5
  // techniques: digital_push from Phase A1/B1's HighlightTimeline,
  // ocr_highlight from OCR Intelligence's price/name tracks, focus_shift
  // from Composition Intelligence's PrimarySubjectSample changes,
  // reaction_hold from Phase 10's emotionalPeaks, pause_hold from
  // @speedora/cutlist's silence gaps protected by a nearby Phase 10
  // curiosityPeak/dropPoint). Via a pure composition over 5 already-
  // computed upstream signals, no new detector and no LLM call. Does NOT
  // yet affect the actual crop-path/render decision - that's a later
  // phase's job (C2-C7, see docs/ai/visual-emphasis-engine.md). Same
  // null-semantics/always-a-real-array convention as contextualMomentum/
  // emotionalArc/captionTreatment: null here can ONLY mean this Clip row
  // predates this phase's migration. Computed on every render regardless
  // of the VISUAL_EMPHASIS_ENABLED flag (gates API exposure only - see
  // isVisualEmphasisEnabled()).
  editingSuggestions          Json?
  // AI Clip Library roadmap, Phase P1 - denormalized endTime - startTime,
  // set alongside them at every write site (detect-clips.worker.ts's
  // initial prisma.clip.create, and ClipsService.update's manual trim) -
  // same "store the derived value, don't make callers recompute it"
  // reasoning as Video.durationSeconds above. Exists purely so the clip
  // library filter/sort can use a plain indexed column instead of a
  // cross-column expression Prisma's query builder can't express in a
  // `where`. Null only for pre-existing rows before the backfill script runs.
  durationSeconds             Float?
  createdAt                   DateTime     @default(now())
  updatedAt                   DateTime     @updatedAt

  publishRecords PublishRecord[]
  jobExecutions  JobExecution[]
  comments       Comment[]
  approvals      Approval[]
  versions       ClipVersion[]
  platformCopies ClipPlatformCopy[]

  @@index([videoId])
  @@index([viralityScore])
  @@index([durationSeconds])
}

// Phase 1 instrumentation for the render-graph executor (apps/worker/src/render-graph/executor.ts
// - see ARCHITECTURE.md's "Composing multiple modules" section). One row per runGraph() call (i.e.
// one per render-clip job), parent to that run's NodeExecution rows below. Exists so Phase 2
// (weight calibration for the many Fusion Engine signals still at weight: 0 - Composition, Object,
// Speaker, Gesture, etc.) can query real production timing/failure-rate data instead of scraping
// logs - e.g. "which node fails most often", "which detector is most expensive", "does a
// high-confidence Composition signal actually move highlightScore". A job-level parent (rather than
// one flat node-row table) avoids repeating job-wide facts (graphVersion/workerVersion/gitCommit,
// total runtime) on every one of a job's ~30 node rows, and gives "total time for this clip's
// graph" a natural home instead of a SUM() over loosely-related rows.
//
// graphVersion/workerVersion/gitCommit exist because this pipeline is under active development
// (40+ migrations and counting) - without them, telemetry gathered today is unattributable to which
// version of the graph/detectors produced it once the graph looks different in six months.
// workerVersion/gitCommit are best-effort (see render-graph/telemetry.ts) and may be null in local
// dev where those env vars aren't set.
model JobExecution {
  id     String @id @default(cuid())
  clipId String
  clip   Clip   @relation(fields: [clipId], references: [id], onDelete: Cascade)

  graphVersion  String
  workerVersion String?
  gitCommit     String?

  startedAt       DateTime
  finishedAt      DateTime?
  totalDurationMs Int?

  createdAt DateTime @default(now())

  nodeExecutions NodeExecution[]

  @@index([clipId])
}

// One row per graph node per JobExecution. `level` is the node's position in the executor's
// Kahn's-algorithm level ordering (see executor.ts's computeLevels()) - not currently used for
// anything (all levels run sequentially today), but cheap to capture now and needed later to
// reconstruct a per-level timeline once `concurrency: 'level-parallel'` is ever turned on for real
// detectors (see ARCHITECTURE.md's executor section on why that's gated on a capacity-planning
// decision, not an architecture one).
model NodeExecution {
  id             String       @id @default(cuid())
  jobExecutionId String
  jobExecution   JobExecution @relation(fields: [jobExecutionId], references: [id], onDelete: Cascade)

  nodeId String
  level  Int
  status NodeExecutionStatus

  startedAt  DateTime
  finishedAt DateTime
  durationMs Int

  // Only set when status is FALLBACK or FAILED - the caught error's message (never the full error
  // object/stack), same "tags only" discipline as VideoStatusEvent.errorMessage.
  errorMessage String?
  // Deliberately unpopulated today - no node currently has a way to attach extra context beyond
  // its typed `Out` value (see executor.ts's GraphNode<Ctx, Out>), and inventing that plumbing
  // ahead of a concrete need would be exactly the kind of speculative abstraction this codebase
  // avoids. Reserved so a future per-node detail (e.g. frame count, detector confidence) doesn't
  // need its own migration - same "one JSON blob, not a column per metric" call already made for
  // Clip.scores.
  metadata     Json?

  @@index([nodeId, startedAt])
  @@index([jobExecutionId])
}

enum NodeExecutionStatus {
  SUCCESS
  FALLBACK
  FAILED
}

// A connected social platform account for publishing (Fase 6a - connect
// only, no publish action yet; see CLAUDE.md's "Publish Center" section).
// One user can connect multiple accounts, including multiple accounts on
// the same platform (e.g. two different YouTube channels).
model SocialAccount {
  id                      String         @id @default(cuid())
  userId                  String
  user                    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform                SocialPlatform
  // The platform's own account/channel id - e.g. a YouTube channel id.
  // Used together with the unique constraint below to detect "already
  // connected" and upsert instead of creating a duplicate row when a user
  // reconnects the same account.
  platformAccountId       String
  // Human-readable label for the "Connect account" UI - e.g. the YouTube
  // channel title. Refreshed from the platform on every (re)connect.
  displayName             String
  // AES-256-GCM encrypted (packages/social's token-encryption.ts, shared
  // with apps/worker's publish-clip job - see Fase 6b) - never plaintext at
  // rest. Stored as "<iv>:<authTag>:<ciphertext>", all hex-encoded.
  accessToken             String
  refreshToken            String
  tokenExpiresAt          DateTime
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  // Stabilization Pass Area 5 tech-debt fix: incremented on every sync
  // failure (sync-publish-stats.worker.ts/sync-follower-count.worker.ts),
  // reset to 0 on any success for that account. Read by alert-engine.worker
  // .ts's sync-failure-warning rule to notify the account owner once it
  // crosses SYNC_FAILURE_ALERT_THRESHOLD, instead of failing forever with
  // no visibility. lastSyncFailureAt is display-only (surfaced in the
  // notification body), not itself compared against a threshold.
  consecutiveSyncFailures Int            @default(0)
  lastSyncFailureAt       DateTime?

  publishRecords     PublishRecord[]
  // Publishing Expansion Phase 6 (Scheduling)
  recurringSchedules RecurringSchedule[]
  // Sprint 6F (Analytics Dashboard Expansion - Followers)
  followerSnapshots  SocialAccountFollowerSnapshot[]

  @@unique([userId, platform, platformAccountId])
  @@index([userId])
}

// One row per publish attempt of a clip to a connected social account.
// scheduledAt is null for an immediate "publish now" (Fase 6b, status starts
// at QUEUED) and set for a future scheduled publish (Fase 6c, status starts
// at SCHEDULED until the schedule-publish-clip poller claims it).
model PublishRecord {
  id              String        @id @default(cuid())
  clipId          String
  clip            Clip          @relation(fields: [clipId], references: [id], onDelete: Cascade)
  socialAccountId String
  socialAccount   SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  status          PublishStatus @default(QUEUED)
  // Set only for a scheduled publish (Fase 6c) - null means "publish now".
  scheduledAt     DateTime?
  publishedAt     DateTime?
  // The platform's own id for the published content (e.g. a YouTube video
  // id) - used to link back to it once published.
  platformPostId  String?
  errorMessage    String?
  // Latest-known snapshot only (Fase 6e), overwritten on every sync-publish-
  // stats run - not a historical time series. All null until the first sync
  // after publish, and permanently null for TikTok (Upload to Inbox mode
  // has no fetchable public video id to query stats for - see CLAUDE.md's
  // Fase 6e section).
  viewCount       Int?
  likeCount       Int?
  commentCount    Int?
  statsUpdatedAt  DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  statsSnapshots PublishRecordStatsSnapshot[]

  // Publishing Expansion Phase 6 (Scheduling) - both nullable and
  // independent of each other and of scheduledAt itself: a job can belong
  // to neither, either, or both a Campaign and a RecurringSchedule. This
  // row (PublishRecord) IS the "PublishJob" execution unit described in the
  // Campaign/RecurringSchedule design - not a separate table, see
  // CLAUDE.md's Publish Center section. onDelete: SetNull (not Cascade) -
  // deleting a Campaign/RecurringSchedule must never delete or orphan a job
  // that already fired or is in flight, it just detaches from the group.
  campaignId          String?
  campaign            Campaign?          @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  recurringScheduleId String?
  recurringSchedule   RecurringSchedule? @relation(fields: [recurringScheduleId], references: [id], onDelete: SetNull)

  // Sprint 6K (Conversion) - a PublishRecord can have zero, one, or more
  // TrackedLinks attached (a creator may want more than one trackable link
  // for the same publish) - onDelete: Cascade here (unlike campaignId/
  // recurringScheduleId's SetNull above) since a TrackedLink scoped to one
  // specific publish has no meaning once that publish record is gone.
  trackedLinks TrackedLink[]

  @@index([clipId])
  @@index([socialAccountId])
  // schedule-publish-clip.worker.ts's poller runs this exact
  // (status, scheduledAt) combination every 60 seconds, forever, for the
  // life of the deployment - a composite index keeps that query cheap
  // regardless of how many PublishRecord rows accumulate over time.
  @@index([status, scheduledAt])
  @@index([campaignId])
  @@index([recurringScheduleId])
}

// Milestone 1 (Dataset & Feedback Loop): one append-only row per
// sync-publish-stats run, unlike PublishRecord's own viewCount/likeCount/
// commentCount which stay a mutable "latest snapshot". This is what lets us
// join AI features (Clip.highlightBreakdown etc.) against a real engagement
// trend instead of a single point-in-time number. watchTimeSeconds is only
// ever populated for Instagram today - YouTube/TikTok have no comparable
// metric available without the (deferred) YouTube Analytics API scope.
model PublishRecordStatsSnapshot {
  id               String        @id @default(cuid())
  publishRecordId  String
  publishRecord    PublishRecord @relation(fields: [publishRecordId], references: [id], onDelete: Cascade)
  capturedAt       DateTime      @default(now())
  viewCount        Int?
  likeCount        Int?
  commentCount     Int?
  shareCount       Int?
  watchTimeSeconds Float?
  // Heuristic, unvalidated composite - see computeEngagementScore in
  // packages/social. Null whenever viewCount is null/0.
  engagementScore  Float?

  @@index([publishRecordId, capturedAt])
}

// Sprint 6F (Analytics Dashboard Expansion - Followers). Same append-only-
// snapshot shape as PublishRecordStatsSnapshot, but account-level rather
// than per-post - one row per sync-follower-count run for one SocialAccount.
// No row is ever created for a platform/account this app can't fetch a
// follower count for (LinkedIn/Threads have no public API for it at all;
// TikTok needs the user.info.stats scope, so accounts connected before that
// scope was added get no rows until they reconnect) - absence of recent
// rows *is* the "not available" signal here, same posture
// PublishRecordStatsSnapshot.watchTimeSeconds already has for non-Instagram
// platforms. See packages/analytics-report's platform-capability.util.ts.
model SocialAccountFollowerSnapshot {
  id              String        @id @default(cuid())
  socialAccountId String
  socialAccount   SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  capturedAt      DateTime      @default(now())
  followerCount   Int

  @@index([socialAccountId, capturedAt])
}

// Publishing Expansion Phase 6 (Scheduling). Mirrors CampaignStatus in
// packages/shared/src/types/campaign.ts. Deliberately NOT a stored column
// on Campaign - see CampaignsService's computeCampaignStatus(), which
// derives this entirely from Campaign.cancelledAt plus the aggregate
// status of its PublishRecords, so there's no second source of truth to
// drift out of sync with the jobs it's summarizing.
enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  COMPLETED
  CANCELLED
}

// Publishing Expansion Phase 6 - a named group of publish jobs
// (PublishRecords) across clips/platforms, for a coordinated multi-platform
// launch. Deliberately does NOT have budget/KPI/target reach/ROI/
// conversion/ad spend/marketing funnel/audience segment fields - those
// belong to a future Marketing Automation / Social Media Management suite,
// not Speedora (explicit user decision). Workspace-scoped the same way
// Video already is (Video.workspaceId), not a new access-control construct.
model Campaign {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  description String?
  tag         String?
  startDate   DateTime
  endDate     DateTime
  // Set only by CampaignsService.cancel() - see the CampaignStatus comment
  // above for why this is the one piece of status state that has to be
  // stored (CANCELLED can't be re-derived from job state alone).
  cancelledAt DateTime?
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  publishRecords PublishRecord[]
  // Sprint 6K (Conversion) - a campaign-wide trackable link (as opposed to
  // TrackedLink.publishRecordId's single-publish scope) - same Cascade
  // reasoning as PublishRecord's own trackedLinks relation.
  trackedLinks   TrackedLink[]

  @@index([workspaceId])
}

// Publishing Expansion Phase 6 - automatic recurring publish time *slots*
// (e.g. "TikTok every Mon/Wed/Fri at 9am Asia/Jakarta"). Deliberately NOT a
// "repost the same clip on a cadence" mechanism (explicit user decision) -
// that's a different, deferred feature needing its own duplicate-content/
// platform-policy/repost-interval handling, kept separate so this system's
// logic stays clean. Clips are queued against a schedule via the existing
// POST /clips/:id/publish endpoint (recurringScheduleId field) - see
// ClipsService.publish() and next-slot.util.ts's computeNextSlot(), which
// assigns each queued clip the next open slot synchronously at queue time,
// not via a separate periodic sweep.
model RecurringSchedule {
  id              String         @id @default(cuid())
  workspaceId     String
  workspace       Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name            String
  platform        SocialPlatform
  // Which connected account to publish to - a workspace/user can have more
  // than one connected account on the same platform, so `platform` alone
  // isn't enough to actually target a SocialAccount (same "picks first,
  // revisit if needed" reasoning as this app's other first-pass account
  // selection code, except here the user picks explicitly at create time
  // instead of the app guessing).
  socialAccountId String
  socialAccount   SocialAccount  @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  // IANA timezone name (e.g. "Asia/Jakarta") - the first place in this app
  // that's timezone-aware at all; see next-slot.util.ts.
  timezone        String
  // 0=Sunday..6=Saturday, matches JS Date.getDay() - Postgres/Prisma scalar
  // list, not a join table, since order/uniqueness within the array doesn't
  // matter and it's always read as a whole.
  daysOfWeek      Int[]
  // "HH:mm", 24h, wall-clock time in `timezone` - a plain string rather
  // than a DateTime since Prisma/Postgres has no portable "time of day
  // only" type; validated at the DTO level.
  timeOfDay       String
  active          Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  publishRecords PublishRecord[]

  @@index([workspaceId])
}

// Sprint 1-2 (Dashboard Redesign, Product Experience track) - a
// user-facing activity feed, distinct from VideoStatusEvent above:
// VideoStatusEvent is an internal pipeline audit trail (one row per status
// transition, written by @speedora/database's updateVideoStatus() helper);
// ActivityEvent is a coarser, human-readable feed of things the DASHBOARD
// shows ("Video uploaded", "Clip generated", ...), written from a handful
// of call sites (VideosService.upload()/importFromYoutube(),
// render-clip.worker.ts, ClipsController's download route, TeamService's
// invite endpoint) via the new recordActivityEvent() helper, same
// "append-only, written by one shared helper" shape as VideoStatusEvent.
enum ActivityEventType {
  VIDEO_UPLOADED
  CLIP_GENERATED
  CLIP_EXPORTED
  MEMBER_INVITED
  // Workspace Lifecycle Management roadmap - see AuditAction's own comment
  // on why WORKSPACE_DELETED is recorded here (userId-scoped, survives)
  // rather than as an AuditLogEntry (cascade-deleted with its own
  // workspace).
  WORKSPACE_DELETED
}

model ActivityEvent {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        ActivityEventType
  videoId     String?
  clipId      String?
  // Free-form display context (e.g. { title } for a video/clip that may
  // since have been deleted) - kept as JSON rather than a live relation
  // read at feed-render time so a deleted video/clip doesn't blank out its
  // own history entry.
  metadata    Json?
  // Activity Timeline v2 - denormalized at write time (recordActivityEvent,
  // via packages/shared's describeActivityEvent) from type+metadata, so
  // GET /dashboard/activity's search can `contains` real text instead of
  // needing to re-derive the Indonesian display sentence per event type at
  // query time. Nullable (no NOT NULL backfill requirement) - a
  // not-yet-backfilled pre-existing row just never matches a search, which
  // is the correct degrade, not a bug. title is the fixed action phrase
  // ("Video diunggah"), description is the variable part (a video title,
  // an email, a workspace name) - null when the event type has none.
  title       String?
  description String?
  createdAt   DateTime          @default(now())

  @@index([userId, createdAt])
}

// Activity Timeline v2 - an internal-only (no DTO, no controller route)
// traceability trail for a user deleting their OWN activity history.
// Deliberately NOT AuditLogEntry (workspaceId-required, doesn't fit a
// per-user action) and NOT a soft-delete flag on ActivityEvent itself (no
// deletedAt precedent exists anywhere in this schema - see this codebase's
// existing three purpose-built audit-adjacent models, AuditLogEntry/
// SecurityEvent/VideoStatusEvent, for why a narrow fourth here is
// consistent with, not a departure from, its own convention). "Delete one"
// is just DELETE_SELECTED with a 1-element deletedIds array, not a 3rd
// enum value - same reuse-over-new-enum-value posture as this codebase's
// LOGOUT_ALL/LOGOUT_OTHERS precedent.
enum ActivityDeletionAction {
  DELETE_SELECTED
  DELETE_ALL
}

model ActivityDeletionLog {
  id         String                 @id @default(cuid())
  userId     String
  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  action     ActivityDeletionAction
  // Set only for DELETE_SELECTED (bounded by whatever the user had
  // selected in the UI); always null for DELETE_ALL - the rows are gone
  // and an unbounded id array serves no purpose once `count` already
  // captures the magnitude.
  deletedIds Json?
  count      Int
  createdAt  DateTime               @default(now())

  @@index([userId, createdAt])
}

// Notification Center Sprint 4A (Product Experience track) - in-app-only
// delivery. Deliberately a SEPARATE model from ActivityEvent, not a
// rename/extension of it: ActivityEvent stays a passive "what happened" feed
// (Dashboard's Activity Timeline); Notification is "what was actually
// delivered to a channel" and carries read-state (readAt), which
// ActivityEvent has never needed. Grown incrementally per shipped
// trigger/rule, same discipline as ActivityEventType/ExportType. The four
// originally-deferred "Collaboration-blocked" events (Review Request/
// Comment/Approval/Member Invitation Accepted) all shipped across Sprint
// 5C/5D and Milestone 04f - see each type's own comment below.
enum NotificationType {
  UPLOAD_COMPLETE
  CLIP_READY
  EXPORT_READY
  RENDER_FAILED
  // Sprint 4C (Alert Engine) - the first state-based (not event-driven)
  // types, backed by AlertState below. See
  // packages/database/src/alert-engine.ts.
  STORAGE_WARNING
  CREDIT_WARNING
  // Sprint 5C (Comments) - two of the four notification types the original
  // Notification Center roadmap flagged "Collaboration-blocked" (see
  // NotificationWebhook's own comment above). COMMENT fires for the video's
  // owner (a new top-level comment or reply, unless they're the author);
  // MENTION fires for each explicitly @mentioned workspace member,
  // regardless of who owns the video.
  COMMENT
  MENTION
  // Sprint 5D (Approval) - the last two of the four originally
  // "Collaboration-blocked" notification types. REVIEW_REQUEST fires when
  // an Approval is created (to the assigned reviewer, or the video owner
  // if none was named); APPROVAL fires when a reviewer decides
  // (APPROVED/REJECTED/NEEDS_REVISION all fire this one type, back to
  // whoever requested the review) - see ApprovalStatus below.
  REVIEW_REQUEST
  APPROVAL
  // Milestone 04f - closes out the Notification Center roadmap's last
  // deferred type. Fires to the inviter (PendingInvite.inviterId) when
  // someone accepts their workspace invite - see
  // WorkspaceService.acceptInvite.
  MEMBER_INVITATION_ACCEPTED
  // Stabilization Pass Area 5 tech-debt fix (2026-07-24) - a third
  // state-based AlertRule alongside STORAGE_WARNING/CREDIT_WARNING, fired
  // per-account (not system-wide) once SocialAccount.consecutiveSyncFailures
  // crosses the alert-engine.worker.ts threshold. See alert-engine.ts's own
  // comment on AlertRule for the general re-arm/dedupe pattern this reuses.
  SYNC_FAILURE_WARNING
  // Notification Center v2 Phase 2 (Notification Engine) - the ONE type used
  // for every NON-TERMINAL Smart Timeline pipeline-thread update (Importing/
  // Uploaded/Pending Settings/Transcribed/Clips Detected/Rendering-progress).
  // The two terminal outcomes reuse existing types instead (CLIP_READY on
  // success, RENDER_FAILED on failure) - see
  // derivePipelineThreadPresentation() in video-status.ts, the only place
  // that decides which type a given VideoStatus/sub-stage maps to. Not used
  // for any single-shot (non-threaded) notification.
  PIPELINE_PROGRESS
  // Transfer Ownership roadmap - fires to the new owner when
  // WorkspaceService.transferOwnership completes, same "positive
  // collaboration event" tone as MEMBER_INVITATION_ACCEPTED.
  WORKSPACE_OWNERSHIP_TRANSFERRED
  // Generate More Clips roadmap (Phase C) - fires from
  // generate-more-clips.worker.ts when scoreClipCandidates (after overlap
  // filtering) returns zero usable new candidates. The only outcome of that
  // job with no other observable signal: new clips rendering already
  // surfaces via the existing CLIP_READY per clip, and a hard failure
  // already surfaces via RENDER_FAILED - this is neither, it's "the job
  // succeeded but found nothing new to add," which needs its own type so
  // the message doesn't read as an error.
  GENERATE_MORE_NO_CANDIDATES
  // Download Reliability Framework - a fourth state-based AlertRule
  // alongside STORAGE_WARNING/CREDIT_WARNING/SYNC_FAILURE_WARNING, fired
  // system-wide (recipients = ops-role users, same as STORAGE_WARNING) once
  // recentInternalCrashes (packages/shared's video-import-metrics.ts) crosses
  // alert-engine.worker.ts's threshold within its rolling window - see
  // videoImportInternalCrashSpikeRule.
  IMPORT_FAILURE_SPIKE
}

// Only IN_APP for Sprint 4A. Milestone 04d wired SLACK/DISCORD/WEBHOOK, 04e
// wired TELEGRAM - each an outbound delivery surface a user can
// independently enable/disable per NotificationType (see
// NotificationPreference below), backed by a destination configured once
// via NotificationWebhook.
//
// Notification Center v2 (Phase 1) - EMAIL/PUSH/DESKTOP added here schema-
// only, ahead of any delivery logic, so the Preferences UI (Phase 6) doesn't
// need a second migration. No worker/service reads these 3 values yet - see
// NotificationCategoryPreference below for why "unimplemented but toggleable"
// is an explicit, honest UI state rather than a hidden gap. EMAIL was
// previously unscheduled/deferred; folded into this same batch rather than
// staying a special case.
enum NotificationChannel {
  IN_APP
  SLACK
  DISCORD
  WEBHOOK
  TELEGRAM
  EMAIL
  PUSH
  DESKTOP
}

// Notification Center v2 - a coarse "which product area" bucket for the
// filter chips/preference grouping UI, orthogonal to NotificationType (many
// types map to one category, see NOTIFICATION_TYPE_CATEGORY in
// notification.ts). ANALYTICS has no backing NotificationType yet - reserved
// so the filter UI has a stable, complete set to render even before a type
// exists for it.
enum NotificationCategory {
  UPLOAD
  AI_PROCESSING
  CLIP_GENERATION
  RENDERING
  PUBLISHING
  ANALYTICS
  BILLING
  WORKSPACE
  SYSTEM
  ERRORS
}

// A 5-level severity, superseding the narrower 3-value NOTIFICATION_SEVERITY
// (success/warning/error) that lived only in packages/shared - this is now
// the source of truth, derived per-type (see NOTIFICATION_TYPE_PRIORITY) with
// an optional per-call override for types whose real severity depends on an
// outcome, not just the type (e.g. APPROVAL).
enum NotificationPriority {
  INFO
  SUCCESS
  WARNING
  ERROR
  CRITICAL
}

// Notification Center v2 - per-channel outbound delivery ledger. Retires the
// notification-delivery.worker.ts's previous "one job = every channel, any
// failure retries all of them" accepted V1 risk (see that worker's own
// comment) by letting each channel track its own attempts/status/lastError
// independently.
enum NotificationDeliveryStatus {
  PENDING
  SENT
  FAILED
}

// Notification Center v2 (Phase 1) - the small, closed state set a
// NotificationThread's header can be in. Mirrors
// PipelineTimelineDto['overallStatus'] in notification-timeline.ts (that
// function derives the live per-stage detail at read time from
// VideoStatusEvent; this enum is only the thread's own coarse aggregate,
// cheap to filter/sort on without joining out to VideoStatusEvent).
enum NotificationThreadStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

model Notification {
  id         String               @id @default(cuid())
  userId     String
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       NotificationType
  // Notification Center v2 - derived from `type` at write time
  // (NOTIFICATION_TYPE_CATEGORY/NOTIFICATION_TYPE_PRIORITY in
  // notification.ts), never chosen ad hoc per call site.
  category   NotificationCategory
  priority   NotificationPriority
  title      String
  body       String
  videoId    String?
  clipId     String?
  // Same "free-form display context, JSON not a live relation" reasoning as
  // ActivityEvent.metadata - e.g. { errorMessage } for RENDER_FAILED, kept
  // out of `body` itself so raw internal error text is never rendered
  // verbatim to the end user.
  metadata   Json?
  readAt     DateTime?
  // Notification Center v2 - a genuine third state alongside unread/read.
  // NULL = active, non-null = archived. Kept as a nullable timestamp (not a
  // separate `state` enum) for the same reason `readAt` already is - "when"
  // is strictly more useful than "whether", and the two states compose
  // independently (an archived notification can be read or unread).
  archivedAt DateTime?
  // Notification Center v2 (Phase 1) - "which thread/group does this
  // representative row belong to" is now a real FK, not the string groupKey
  // convention an earlier uncommitted pass used. At most one of
  // threadId/groupId is ever set on a given row (a Notification either
  // belongs to a per-video pipeline thread, a flat dedup group, or neither -
  // never both). onDelete: SetNull, not Cascade - deleting a thread/group
  // header (e.g. via purgeExpiredNotifications on its own future extension)
  // should never cascade-delete the representative Notification row itself.
  thread     NotificationThread?  @relation(fields: [threadId], references: [id], onDelete: SetNull)
  threadId   String?
  group      NotificationGroup?   @relation(fields: [groupId], references: [id], onDelete: SetNull)
  groupId    String?
  // Notification Center v2 - read by the retention job
  // (notification-expiry.worker.ts). NULL means "no explicit expiry", not
  // "never expires" - autoArchiveStaleNotifications()/
  // purgeExpiredNotifications() key off createdAt/archivedAt age, not this
  // column, for every existing row; this field is reserved for a future
  // per-type explicit TTL (e.g. a transient progress-only notification that
  // should vanish quickly even if unread) and is unused by any write path
  // today.
  expiresAt  DateTime?
  createdAt  DateTime             @default(now())
  // Notification Center v2 Phase 3 (API Layer) - real "last touched" signal
  // for the V2 list's sort order. Prisma bumps this automatically on every
  // .update() call, including the progress/resurface updates
  // recordThreadNotification()/recordGroupedNotification() already make -
  // so an updated thread genuinely resurfaces to the top of the V2 list, not
  // just conceptually (see this model's own groupKey-era comment on
  // "resurface"). createdAt above stays immutable (when the row was FIRST
  // created); this is the separate "when it last changed" signal the V1
  // list's plain createdAt-only sort never needed (V1 never updates a row
  // after creation).
  updatedAt  DateTime             @updatedAt

  deliveries   NotificationDelivery[]
  readReceipts NotificationReadReceipt[]

  // Enforces the "one representative row per thread/group" invariant -
  // Postgres treats NULL as distinct per row, so the vast majority of
  // Notification rows (threadId/groupId both null) never collide with each
  // other. See recordThreadNotification()/recordGroupedNotification() in
  // notification.ts - each relies on this exact constraint for its
  // create-then-catch-P2002-then-update idiom.
  @@unique([threadId])
  @@unique([groupId])
  @@index([userId, createdAt])
  // Serves the unread-count endpoint's count({ where: { userId, readAt:
  // null } }) query.
  @@index([userId, readAt])
  // Notification Center v2 - serves V1's list endpoint (non-archived,
  // most-recent-CREATED-first - V1 never updates a row after creation, so
  // createdAt is the correct sort key there).
  @@index([userId, archivedAt, createdAt])
  // Notification Center v2 Phase 3 - serves the V2 list endpoint's default
  // query (non-archived, most-recently-ACTIVE-first via updatedAt) - see
  // that column's own comment above for why V2 needs a different sort key
  // than V1's createdAt-only index.
  @@index([userId, archivedAt, updatedAt])
}

// Notification Center v2 (Phase 1) - one row per per-job pipeline thread
// (today: one per Video, key = "PIPELINE:<videoId>"). This is a real,
// separate header/aggregate entity - not a duplicated event log. The
// detailed per-stage timeline (Upload Started -> ... -> Completed) stays
// derived at READ TIME from VideoStatusEvent/Video's own progress columns
// (see notification-timeline.ts's computePipelineTimeline) - "real data
// only," per this feature's own guiding constraint, means never storing a
// second copy of state that VideoStatusEvent already durably owns. What a
// NotificationThread row DOES own for real: which user's thread this is,
// its coarse aggregate status/title for list rendering, and when it was
// last active - all genuinely new state, not a fabrication of AI pipeline
// detail that doesn't exist yet.
model NotificationThread {
  id             String                   @id @default(cuid())
  userId         String
  user           User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Deterministic per-user dedup key, e.g. "PIPELINE:<videoId>". See
  // recordThreadNotification() in notification.ts - the sole writer.
  key            String
  // Denormalized reference, not a live Prisma relation - same convention as
  // Notification.videoId/clipId above (see that field's own comment).
  videoId        String?
  title          String
  status         NotificationThreadStatus @default(IN_PROGRESS)
  lastActivityAt DateTime                 @default(now())
  archivedAt     DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  notifications Notification[]

  // Enforces "at most one active thread per (userId, key)" - the
  // database-level guarantee recordThreadNotification()'s
  // create-then-catch-P2002-then-update idiom relies on.
  @@unique([userId, key])
  @@index([userId, archivedAt, lastActivityAt])
}

// Notification Center v2 (Phase 1) - general dedup envelope for identical
// *repeated* events that are NOT a per-video pipeline (e.g. repeated
// STORAGE_WARNING, repeated SYNC_FAILURE_WARNING). Same
// create-or-update-by-key mechanics as NotificationThread, but no sub-
// timeline - the UI renders this as a flat "x N" badge on the one
// representative Notification row, never an expandable stage list.
model NotificationGroup {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Deterministic per-user dedup key, e.g. "TYPE:<type>:<videoId>". See
  // recordGroupedNotification() in notification.ts - the sole writer.
  key             String
  occurrenceCount Int       @default(1)
  firstOccurredAt DateTime  @default(now())
  lastOccurredAt  DateTime  @default(now())
  archivedAt      DateTime?
  createdAt       DateTime  @default(now())

  notifications Notification[]

  @@unique([userId, key])
  @@index([userId, archivedAt, lastOccurredAt])
}

// Notification Center v2 (Phase 1) - a real per-(notification, user) read
// audit trail. Notification.readAt stays the authoritative fast-path column
// for the unread-count/list-filter queries (unchanged perf characteristics,
// no join needed for the hot path) - this table is additive, written
// alongside it (see recordReadReceipt() in notification.ts) rather than
// replacing it. Every Notification row is single-recipient today (userId
// already identifies the one owner), so userId here always equals
// Notification.userId for now - this is genuine "who read this and when"
// infrastructure, not a placeholder, ready for a future multi-recipient
// notification (e.g. a workspace-wide announcement) without a schema
// change.
model NotificationReadReceipt {
  id             String       @id @default(cuid())
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime     @default(now())

  @@unique([notificationId, userId])
}

// Notification Center v2 (Phase 1, wired in Phase 6) - a coarse per-category
// toggle, deliberately a SEPARATE table from the existing per-type
// NotificationPreference below rather than overloading its shape - adding a
// nullable `category` dimension to that table's unique index would touch
// every existing row/query for zero benefit this phase. Resolution order
// (explicit per-type NotificationPreference row > this category-level row >
// default-enabled) is an API-layer concern for Phase 6, not a schema one -
// this table is inert (no reader) until then.
model NotificationCategoryPreference {
  id        String               @id @default(cuid())
  userId    String
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  NotificationCategory
  channel   NotificationChannel
  enabled   Boolean              @default(true)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@unique([userId, category, channel])
}

// Notification Center v2 - one row per (Notification, channel) outbound
// delivery attempt. See NotificationDeliveryStatus above for why this
// exists; notification-delivery.worker.ts is the sole writer.
model NotificationDelivery {
  id             String                     @id @default(cuid())
  notificationId String
  notification   Notification               @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  channel        NotificationChannel
  status         NotificationDeliveryStatus @default(PENDING)
  attempts       Int                        @default(0)
  lastError      String?
  deliveredAt    DateTime?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  @@unique([notificationId, channel])
}

// Was schema-only in Sprint 4A; wired in Sprint 4B (IN_APP only) and
// Milestone 04d (SLACK/DISCORD/WEBHOOK). A genuine per-(user, type, channel)
// matrix, not a JSON blob on User - different shape from Brand Kit's few
// singleton columns (see this file's own comment on User.brandLogoUrl for
// why THAT stayed flat). `config` (Sprint 4B) holds `{ toast?: boolean }` on
// the IN_APP row only - toast is a client-only ephemeral presentation of a
// Notification row that already exists via IN_APP, not a distinct delivery
// mechanism, so it's NOT a second NotificationChannel value (that would
// create a reachable-but-meaningless enabled=false/toast=true state -
// nothing is ever created to toast about). `config` stays unused for
// SLACK/DISCORD/WEBHOOK rows - the actual destination (URL) lives on
// NotificationWebhook below, not here, since it's one account-level secret
// per channel, not something that varies per NotificationType.
model NotificationPreference {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  channel   NotificationChannel
  enabled   Boolean             @default(true)
  config    Json?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@unique([userId, type, channel])
}

// Milestone 04d - one row per (userId, channel), an account-level outbound
// destination shared by every enabled NotificationType for that channel.
// Mirrors SocialAccount's "one connected destination, referenced by many
// downstream rows" shape, without the OAuth complexity - just a single
// secret URL. IN_APP is deliberately excluded (rejected at the service
// layer, not the schema) since it has no external destination to configure.
//
// Milestone 04e (Telegram) - reuses this same model rather than a dedicated
// TelegramConnection, so every existing consumer (the delivery worker,
// getWebhooks/deleteWebhook, the @@unique([userId, channel]) invariant)
// keeps branching on nullable columns instead of learning a second table.
// For TELEGRAM only: `url` holds the encrypted BOT TOKEN, not a URL (a
// Telegram bot has no callable webhook URL of its own - the token is what
// both proves ownership and builds the api.telegram.org request URL at
// send time). `chatId` is null the instant the token is saved (a bot token
// alone doesn't say who to message) and stays null until the durable
// long-polling discovery worker (telegram-chat-discovery.worker.ts) sees
// the user message their own bot - "configured" now genuinely means
// "chatId is known", not just "a secret is saved", which is why
// NotificationWebhookDto grew a separate `pending` field rather than
// reusing `configured` for this in-between state.
model NotificationWebhook {
  id                   String              @id @default(cuid())
  userId               String
  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel              NotificationChannel
  // AES-256-GCM encrypted at rest via webhook-encryption.ts (same pattern
  // as SocialAccount.accessToken/refreshToken - see that field's own
  // comment) - stored as "<iv>:<authTag>:<ciphertext>", all hex. Never
  // decrypted back to a client - NotificationWebhookDto only ever exposes
  // `configured: boolean`. For TELEGRAM this holds the encrypted bot token
  // (see this model's own comment above), not a URL.
  url                  String
  // TELEGRAM only - the chat_id discovered by telegram-chat-discovery.worker.ts.
  // Null for every other channel and for a TELEGRAM row still pending
  // discovery.
  chatId               String?
  // TELEGRAM only - cached from the Telegram getMe API at save time, so the
  // "message your bot" onboarding UI can render a t.me/<username> deep link
  // without a second Telegram call.
  telegramBotUsername  String?
  // TELEGRAM only - the getUpdates pagination cursor, persisted durably
  // (not in-memory) so a /start message is processed exactly once and never
  // reprocessed after an apps/worker restart - the discovery poller's whole
  // reason for existing as a durable Postgres column rather than a
  // process-local variable.
  telegramUpdateOffset Int?
  // Notification Center v2 Phase 5 (Preferences & Delivery) - the simplified
  // preferences UI's single per-channel "Enabled" checkbox. Separate from
  // `configured` (whether a destination URL/token exists at all, derived
  // from row presence) - a channel can be configured but temporarily
  // disabled without losing/re-entering its secret. Defaults true so every
  // pre-Phase-5 row (created back when this column didn't exist) keeps
  // delivering exactly as it always has - see notification-delivery.worker.ts's
  // own query, which now filters on this directly.
  enabled              Boolean             @default(true)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@unique([userId, channel])
}

// Subtitle Presets roadmap (P3b) - a named, user-saved bundle of the 3
// "subtitle look" axes (captionStyle/speakerColorCaptions/fontFamily),
// selectable per clip in the Timeline Editor. Directly userId-owned (not
// workspace-scoped, like BrandKitTemplate/BrandKit itself - a personal style
// preference, not a team-shared resource) - CRUD shape mirrors Project's
// (the smallest full create/list/update/delete precedent in this codebase),
// ownership check mirrors BrandKitService's direct `where: { userId }`
// guards instead of WorkspaceAccessService. A small, fixed set of built-in
// presets (Default/Minimal/Bold/Karaoke/Creator) also exists, but those are
// a frontend-only constant (packages/shared's BUILT_IN_SUBTITLE_PRESETS) -
// never persisted here, since they're just a convenience bulk-setter into
// already-validated Clip fields.
model SubtitlePreset {
  id                   String       @id @default(cuid())
  userId               String
  user                 User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                 String
  captionStyle         CaptionStyle @default(DEFAULT)
  speakerColorCaptions Boolean      @default(false)
  fontFamily           String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@index([userId])
}

// Pre-Processing Settings roadmap (Phase 0/1) - a named, user-saved snapshot
// of a ProcessingOptions choice (@speedora/shared), same "copy-on-apply,
// directly userId-owned, CRUD shape mirrors ProjectService" pattern as
// SubtitlePreset just above. `config` is stored as one JSON blob rather than
// a column per option (like Clip.scores) since ProcessingOptions is itself a
// nested object, not a flat set of scalars - always read/written as a unit,
// and a future option addition doesn't need its own migration. The 5
// built-in presets (Ultra Fast/Balanced/Professional/Studio Quality/AI Auto)
// are, same as BUILT_IN_SUBTITLE_PRESETS, a frontend-only constant
// (@speedora/shared's BUILT_IN_PROCESSING_PRESETS) - never persisted here.
model ProcessingPreset {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  config    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// Template Presets roadmap (P3f) - a named, user-saved snapshot of every
// field BrandKitService.BRAND_KIT_SELECT reads (the exact set render-enqueue
// resolution actually consumes), letting a user save "the Brand Kit as it is
// right now" and switch back to it later. Directly userId-owned, same CRUD
// shape as SubtitlePreset (mirrors ProjectService's create/list/update/
// remove, ownership checked in findOwnedOrThrow rather than
// WorkspaceAccessService - a personal setting, not a team-shared resource).
// Deliberately workspace-agnostic for now (P3g adds workspace scoping
// uniformly across the whole Brand Kit, not templates specially). Fields are
// a flat 1:1 mirror of User's own brand* columns (raw storage keys, not
// resolved `/brand-kit/...` URLs - this is a server-side snapshot, re-applied
// by copying straight back onto User, not something rendered to a client
// as-is). "Applying" a template copies its fields onto the user's live Brand
// Kit fields; the fields render-clip.worker.ts actually reads stay the same
// flat set on User they always were - a template is purely an editing-
// convenience layer on top, not a new thing renders resolve against.
model BrandKitTemplate {
  id                        String   @id @default(cuid())
  userId                    String
  user                      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                      String
  logoUrl                   String?
  primaryColor              String?
  secondaryColor            String?
  fontFamily                String?
  watermarkUrl              String?
  watermarkOpacity          Float?
  watermarkScale            Float?
  watermarkMargin           Float?
  watermarkPosition         String?
  introUrl                  String?
  introType                 String?
  introImageDurationSeconds Float?
  outroUrl                  String?
  outroType                 String?
  outroImageDurationSeconds Float?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@index([userId])
}

// Sprint 4C (Alert Engine) - durable "is this alert instance currently
// active" tracker, one row per AlertInstance.dedupeKey ('storage-warning'
// for the one system-wide rule, `credit-warning:${userId}` for the
// per-user rule). Presence of a row = already notified, don't re-notify
// while still breached; absence = not active, same "absence = default"
// convention as NotificationPreference. Deleted (not flagged) the moment a
// condition clears, so a later re-breach starts a fresh incident with a
// fresh activeSince - mirrors AlertStateTracker's in-memory
// since-reset-on-absence behavior (apps/api/src/monitoring/alert-state.ts),
// made durable across apps/worker restarts, which that in-memory tracker
// explicitly does not survive (see its own doc comment) and which this
// milestone's de-dup need cannot tolerate.
model AlertState {
  id          String   @id @default(cuid())
  dedupeKey   String   @unique
  activeSince DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// PR #45 (Production Metrics Collection, post-Oracle-hybrid-Fase-3 roadmap)
// - a periodic, append-only snapshot of one BullMQ queue's state, written
// by apps/worker's metrics-snapshot.worker.ts every
// METRICS_SNAPSHOT_INTERVAL_MS (default 5 min). Same "latest-state update
// stays elsewhere, history is purely additive" split
// PublishRecordStatsSnapshot/SocialAccountFollowerSnapshot already
// established - there is no "live" QueueSnapshot row to ever update.
//
// Data collection only, deliberately - no analysis, alerting, dashboard,
// or scaling decision reads this table yet (see the roadmap: PR #44
// shipped the live-state dashboard reading GET /queues directly, a later
// PR reads this table's history to evaluate whether autoscaling is
// actually warranted). Retention/pruning is an explicit, deliberately
// open question - not solved here, see docs/database.md.
//
// queueName is a plain String, not a Prisma enum mirroring
// packages/shared's QueueName - deliberately, not an oversight. BullMQ
// queue names are themselves plain strings at runtime (QueueName's enum
// members ARE those strings), this table is an internal operational
// record rather than a user-facing enum surfaced across dozens of UI
// components the way NotificationType/ActivityEventType are (see
// coding-standards.md's Contract Governance section), and a wrong/stale
// tag here degrades one analytics row, not a crashing UI component - the
// mapper-boilerplate cost of a second mirrored enum isn't proportionate
// here the way it is for those.
model QueueSnapshot {
  id         String   @id @default(cuid())
  queueName  String
  capturedAt DateTime @default(now())

  waiting       Int
  active        Int
  completed     Int
  failed        Int
  delayed       Int
  paused        Int
  likelyStalled Int

  // Sampled over a bounded recent window at capture time (same
  // "no data yet" vs. "zero" nullability, and the same sampling approach,
  // as GET /queues - see @speedora/shared's queue-metrics.ts), not a
  // full-population aggregate since BullMQ doesn't expose these as O(1)
  // aggregates the way the counts above are.
  failureRate         Float?
  avgProcessingTimeMs Int?
  avgQueueWaitMs      Int?
  retriedJobs         Int

  @@index([queueName, capturedAt])
}

// Periodic capture of one worker PROCESS's live heartbeat
// (apps/worker/src/workerHeartbeat.ts) - the history GET /workers/health
// (apps/api, PR #42) only ever shows the current instant of. `queues` is a
// plain string array (Postgres native array via Prisma's String[]) - same
// "not a Prisma enum" reasoning as QueueSnapshot.queueName above, applied
// per-element. A worker that's gone (heartbeat key expired/deleted) simply
// stops appearing in new snapshots - there is no "offline" row, same
// absence-is-the-signal convention GET /workers/health itself uses.
model WorkerHeartbeatSnapshot {
  id                  String   @id @default(cuid())
  workerId            String
  queues              String[]
  jobsActive          Int
  jobsWaiting         Int
  workerStartedAt     DateTime
  heartbeatTtlSeconds Int
  capturedAt          DateTime @default(now())

  @@index([workerId, capturedAt])
}

// Sprint 5A (Collaboration Foundation) - the single permission-rank enum
// for everything workspace-scoped (membership, PendingInvite, and every
// future Collaboration feature - Comments/Approval/Review Mode all gate on
// this same rank rather than inventing their own). Rank order, highest to
// lowest: OWNER > ADMIN > EDITOR > REVIEWER > VIEWER - see
// apps/api/src/workspace/workspace-access.service.ts for the rank table.
// Deliberately NOT the same enum as UserRole above - UserRole is a single
// global flag on User (ops-dashboard access, see Milestone 5C-B);
// WorkspaceRole is per-membership and can differ for the same user across
// different workspaces.
enum WorkspaceRole {
  OWNER
  ADMIN
  EDITOR
  REVIEWER
  VIEWER
}

// Sprint 5A - closes the gap the old PendingInvite comment used to
// describe ("no Team/Membership schema, no shared video/clip access, no
// workspace switching, no role enforcement"). Every User gets exactly one
// isPersonal workspace at signup/backfill (role OWNER) so every Video has
// exactly one workspaceId from day one and access control has a single
// path. ownerId is retained as "who created this workspace" display
// metadata only - WorkspaceMembership is the sole source of truth for
// access. No separate Organization tier above this - deliberately folded
// in for now, no multi-workspace-per-org billing/need exists anywhere in
// this app yet (same "smallest viable" posture as Brand Kit's fields
// living directly on User instead of a new settings system).
model Workspace {
  id                             String   @id @default(cuid())
  name                           String
  isPersonal                     Boolean  @default(false)
  ownerId                        String
  owner                          User     @relation("WorkspaceCreator", fields: [ownerId], references: [id], onDelete: Cascade)
  // Workspace-level Brand Kit roadmap (P3g) - an additive sibling to User's
  // own brand* fields above (same 15 fields, same shape), not a migration -
  // this codebase's stronger, more-repeated convention is additive
  // coexistence over replacement (see docs/data-ownership.md). Render
  // resolution (ClipsService.render()/VideosService.retry()/
  // detect-clips.worker.ts) merges per-field: a video's workspace kit wins
  // when a given field is set, falling back to the video owner's personal
  // (User) kit field-by-field otherwise - and is skipped entirely when the
  // video's workspace isPersonal (the common case - a personal workspace's
  // Brand Kit IS the owner's User row, unchanged from P3a-f). Editing:
  // GET/PUT/upload /brand-kit accept an optional workspaceId query param -
  // omitted (or the requester's own personal workspace) edits these User
  // fields unchanged; any other workspace the requester has EDITOR+ on
  // edits these Workspace fields instead. See BrandKitService's
  // resolveTarget().
  brandLogoUrl                   String?
  brandPrimaryColor              String?
  brandSecondaryColor            String?
  brandFontFamily                String?
  brandWatermarkUrl              String?
  brandWatermarkOpacity          Float?
  brandWatermarkScale            Float?
  brandWatermarkMargin           Float?
  brandWatermarkPosition         String?
  brandIntroUrl                  String?
  brandIntroType                 String?
  brandIntroImageDurationSeconds Float?
  brandOutroUrl                  String?
  brandOutroType                 String?
  brandOutroImageDurationSeconds Float?
  createdAt                      DateTime @default(now())
  updatedAt                      DateTime @updatedAt

  members            WorkspaceMembership[]
  projects           Project[]
  videos             Video[]
  invites            PendingInvite[]
  auditLogEntries    AuditLogEntry[]
  // Publishing Expansion Phase 6 (Scheduling)
  campaigns          Campaign[]
  recurringSchedules RecurringSchedule[]
  // Sprint 6K (Conversion - first-party click-tracking)
  trackedLinks       TrackedLink[]

  @@index([ownerId])
}

model WorkspaceMembership {
  id          String        @id @default(cuid())
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        WorkspaceRole
  createdAt   DateTime      @default(now())

  @@unique([workspaceId, userId])
  @@index([userId])
}

// Sprint 5A - an organizational grouping of Videos within a Workspace.
model Project {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  // Archive roadmap (P1) - NULL = active, non-null = archived. Same
  // nullable-timestamp convention as Notification.archivedAt: an archived
  // Project stays fully intact (folders/videos untouched) and is just
  // excluded from the default list, not soft-deleted - permanent removal is
  // still the separate, ADMIN-gated remove().
  archivedAt  DateTime?

  folders Folder[]
  videos  Video[]

  @@index([workspaceId])
  @@index([workspaceId, archivedAt])
}

// Sprint 5A - nestable within a Project (parentId self-relation). A
// Folder always belongs to exactly one Project (never directly to a
// Workspace) - Video.folderId therefore implies Video.projectId is also
// set, enforced at the service layer, not the schema (same convention as
// this codebase's other cross-field invariants, e.g. ExportJob's
// type/videoId mutual exclusion).
model Folder {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    Folder?  @relation("FolderChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children  Folder[] @relation("FolderChildren")
  name      String
  createdAt DateTime @default(now())

  videos Video[]

  @@index([projectId])
  @@index([parentId])
}

// Sprint 5A - replaces the old one-way "we sent an email" log this model
// used to be (see git history for the prior PendingInviteRole-based
// shape). Now a real invitation lifecycle scoped to one Workspace:
// tokenHash follows the same "hash at rest, never store the raw token"
// convention as User.resetPasswordTokenHash - the raw token only ever
// exists in the emailed accept link; POST /invites/:token/accept looks it
// up, creates the matching WorkspaceMembership, and flips status to
// ACCEPTED. role reuses WorkspaceRole directly rather than keeping a
// second role enum in sync with it.
enum PendingInviteStatus {
  PENDING
  ACCEPTED
  REVOKED
}

model PendingInvite {
  id          String              @id @default(cuid())
  inviterId   String
  inviter     User                @relation(fields: [inviterId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email       String
  role        WorkspaceRole
  status      PendingInviteStatus @default(PENDING)
  tokenHash   String              @unique
  createdAt   DateTime            @default(now())

  @@index([inviterId, createdAt])
  @@index([workspaceId, status])
}

// Sprint 03c (Export Center roadmap) - tracks one async report-generation
// job (currently only PDF; EXCEL/etc. join this enum in Sprint 03d without
// a schema change to ExportJob itself). A concrete videoId relation, not a
// generic Json "scope" blob (the original 03a-era sketch) - now that this
// model actually exists, scope is always exactly one video, and a real FK
// avoids the TS2742 declaration-emit trap this codebase has hit repeatedly
// with untyped Json columns (see ARCHITECTURE.md). No retry-count/backoff
// tracking here - unlike PublishRecord, ExportJob jobs don't get automatic
// BullMQ retry (same "fails once, user re-triggers" convention as every
// pipeline job except publish-clip); a failed row is simply terminal.
// Sprint 03d - EXCEL/HIGHLIGHT_REPORT/BRAND_REPORT all reuse the exact same
// video-scoped data pipeline PDF already uses (buildVideoReportInputFromPrisma
// -> buildVideoReportData) - only the rendering differs. ANALYTICS_REPORT
// (Analytics Report) is the one account-wide type - AnalyticsService.getOverview/
// getPerformance are userId-scoped across every video, never one videoId, so
// ExportJob.videoId became nullable to accommodate it (see below). Built via
// its own pipeline: packages/analytics-report's buildAnalyticsReportData, fed
// by apps/worker's own account-wide adapter (build-analytics-report-input.ts),
// never the video-scoped one the other 4 types share.
enum ExportType {
  PDF
  EXCEL
  HIGHLIGHT_REPORT
  BRAND_REPORT
  ANALYTICS_REPORT
  // Export format expansion (Phase D) - same video-scoped VideoReportData
  // pipeline as PDF/EXCEL, just a PowerPoint renderer
  // (apps/worker/src/export-generate/pptx/video-report-presentation.ts).
  PPTX
}

enum ExportJobStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

model ExportJob {
  id         String          @id @default(cuid())
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Nullable since ANALYTICS_REPORT is account-wide, not tied to one video -
  // every other ExportType still always sets this. Postgres indexes nullable
  // columns fine; the index below simply never matches ANALYTICS_REPORT rows
  // (they're queried by `type`, not `videoId`, in ExportService.listRecent).
  videoId    String?
  video      Video?          @relation(fields: [videoId], references: [id], onDelete: Cascade)
  type       ExportType      @default(PDF)
  status     ExportJobStatus @default(PENDING)
  // Object storage key, set only once status reaches READY - never exposed
  // to the client as this raw key, same "endpoint path instead" treatment
  // as every other resource in this codebase (see ExportJobDto.resultUrl).
  resultUrl  String?
  failReason String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([userId, createdAt])
  // Recent Exports / Persistent Export History - backs GET /export?videoId=
  // (ExportService.listRecent's `WHERE videoId = ? ORDER BY createdAt DESC
  // LIMIT 10`), a real repeated query this feature introduces.
  @@index([videoId, createdAt])
}

// Publishing Expansion Phase 7B (AI SEO - per-platform LLM-generated copy).
// A brand-new, standalone LLM call (caption/hashtags/description for one
// clip+platform) - explicitly NOT part of the frozen detect-clips
// selection/scoring call or the Fusion Engine; never reads or writes
// Clip.scores/viralityScore/highlightScore. Only reads already-stored
// Clip.hookText/topics/keywords/ctaText/reason.
enum ClipPlatformCopyStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

// Append-only, same "on-demand generated artifact" shape as ExportJob
// (deliberately NOT PublishRecord's ownership/execution-unit shape) - every
// Generate/Regenerate click creates a NEW row rather than updating one in
// place. This is what makes the worker's atomic status-claim step
// sufficient on its own: there is never contention over one row between two
// concurrent generations, only the ordinary "BullMQ redelivers a stalled
// job" case. "Current" copy for a platform is resolved client-side as the
// latest row by createdAt (apps/web/lib/platform-copy.ts's
// latestPlatformCopy(), mirroring lib/export.ts's latestJobByType()) -
// mirroring ExportTypeRow's own regenerate-creates-a-new-row precedent.
model ClipPlatformCopy {
  id          String                 @id @default(cuid())
  clipId      String
  clip        Clip                   @relation(fields: [clipId], references: [id], onDelete: Cascade)
  platform    SocialPlatform
  status      ClipPlatformCopyStatus @default(PENDING)
  caption     String?
  hashtags    String[]               @default([])
  description String?
  failReason  String?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  // Backs both "does this platform already have copy?" and the 24h
  // regenerate rate-cap count (ClipsService.generatePlatformCopy) -
  // WHERE clipId = ? AND platform = ? AND createdAt >= ?.
  @@index([clipId, platform, createdAt])
}

// Sprint 5B (Shared Clips) - a lightweight share-link grant, deliberately
// separate from WorkspaceMembership: the holder of a valid link gets
// read-only (or REVIEWER) access to exactly one Video without becoming a
// real workspace member (no membership row, no workspace-switcher
// visibility, no invite lifecycle). Video-scoped only for V1 - a shared
// video's own clips are visible as part of viewing it, so this covers the
// common case without also needing a separate Clip-scoped share flow yet.
enum ShareRole {
  VIEWER
  REVIEWER
}

model ShareLink {
  id          String    @id @default(cuid())
  // Same "hash at rest, raw token only ever in the shareable URL" convention
  // as User.resetPasswordTokenHash/PendingInvite.tokenHash.
  tokenHash   String    @unique
  videoId     String
  video       Video     @relation(fields: [videoId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id], onDelete: Cascade)
  role        ShareRole @default(VIEWER)
  // Null = never expires. Distinct from revokedAt below - an expiry is a
  // passive time-based check at read time; a revocation is an explicit,
  // immediate "the creator turned this off" action, same distinction
  // PendingInviteStatus draws between its own states.
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([videoId])
  @@index([createdById, createdAt])
}

// Authentication Foundation Sprint 1 (Tahap 1 roadmap) - one row per logged-in
// device/browser, backing a refresh-token-rotation scheme. Replaces the old
// single long-lived JWT cookie: the access token (short-lived JWT, carries
// this row's id as its `sid` claim) is now paired with a refresh token whose
// only usable form server-side is this row's refreshTokenHash - same "hash
// at rest, raw token only ever handed to the client once" convention as
// ShareLink.tokenHash/User.resetPasswordTokenHash above. expiresAt (passive,
// time-based) and revokedAt (explicit action) are deliberately separate
// fields, same distinction ShareLink draws between its own two fields.
// browser/os/deviceName are derived from userAgent via ua-parser-js once, at
// creation/rotation time, rather than re-parsed on every future read - all
// three plus ipAddress were added in Sprint 1 ahead of Sprint 3's session
// dashboard having any UI/consumer yet, specifically so Sprint 3 (now
// shipped - GET/DELETE /auth/sessions, POST /auth/logout-others) only
// needed to add endpoints/UI, not another migration.
model Session {
  id               String @id @default(cuid())
  userId           String
  user             User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String @unique

  // Tahap 3.5 (Passkey UX & Observability) - 'password' | 'google' |
  // 'github' | 'passkey', app-level string not a Postgres enum (same
  // posture as revokedReason below). Set once at createSession() time from
  // whichever of AuthController.login/OAuthController.callback/
  // PasskeyController.loginVerify/MfaController.challenge actually created
  // this row - MfaController.challenge reads it back off the MFA challenge
  // token (which now carries a `method` claim) rather than losing it, since
  // completing an MFA challenge is the tail of ALL FOUR login paths, not a
  // fifth one. Exists because there was previously no reliable way to
  // recover "how was this specific still-active session created" at all -
  // SecurityEvent's LOGIN_SUCCESS has no session-row join key, and for any
  // login that went through the MFA challenge the originating method wasn't
  // even captured anywhere. Null only for sessions created before this
  // column existed (never backfilled, same posture as every other
  // introduced-later nullable column in this schema).
  createdVia String?

  userAgent  String?
  browser    String?
  os         String?
  deviceName String?
  ipAddress  String?

  createdAt     DateTime  @default(now())
  lastSeenAt    DateTime  @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?
  // 'logout' | 'logout_all' | 'user_revoked' | 'logout_others' - app-level
  // enum, not a Postgres one, same posture CaptionStyle/brandFontFamily
  // already use elsewhere in this schema. 'user_revoked' (Sprint 3 - a
  // single targeted DELETE /auth/sessions/:id from the dashboard) and
  // 'logout_others' (Sprint 3 - POST /auth/logout-others) added alongside
  // Sprint 1's original two. Never written as 'expired' - that's inferred
  // at read time (expiresAt < now() with revokedAt still null), not
  // swept/persisted.
  revokedReason String?
  // Tahap 2 Step 2 Sprint 2b (Session Elevation) - set by POST /auth/elevate
  // once the caller re-proves their identity (a TOTP/recovery code if MFA
  // is enabled, their current password otherwise). RecentMfaGuard reads
  // this via AuthenticatedUser.elevatedAt (JwtStrategy already fetches this
  // row every request, so no extra query is needed) and treats it as
  // expired once now() - elevatedAt exceeds the elevation window - computed
  // at read time, never swept/persisted as a separate state, same
  // "expiry computed at read time" convention expiresAt above already uses.
  elevatedAt    DateTime?

  @@index([userId])
}

// Tahap 2 Step 1 (OAuth Login) - deliberately NOT a reuse/extension of
// SocialAccount (packages/social's OAuth for YouTube/TikTok/Instagram
// PUBLISHING). SocialAccount requires an existing logged-in userId (you
// connect a publishing account, you don't sign in with one), stores
// encrypted long-lived access/refresh tokens for later API calls, and has
// no email field at all. OAuthIdentity is the opposite: userId may not
// exist yet when the flow starts (a brand-new signup), and no token is
// ever stored - once identity is established at login time, the provider's
// token is discarded; nothing calls back into Google/GitHub's API
// afterward. email is display-only (captured once at link time, never
// re-fetched, never used for lookups - providerAccountId is the real key)
// so a future "linked accounts" UI can show which account is attached
// without a live API call.
enum OAuthProvider {
  GOOGLE
  GITHUB
}

model OAuthIdentity {
  id                String        @id @default(cuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          OAuthProvider
  providerAccountId String
  email             String?
  createdAt         DateTime      @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// Tahap 2 Step 2 Sprint 1 (MFA Foundation) - one row per one-time-use
// recovery/backup code (the same mechanism - not two separate systems),
// generated 10-at-a-time whenever MFA is enabled or recovery codes are
// regenerated (MfaController). codeHash is a SHA-256 hex digest of the raw
// code - same "hash at rest, raw value shown to the user exactly once"
// convention as User.resetPasswordTokenHash/emailVerificationTokenHash and
// Session.refreshTokenHash. usedAt is set the first (and only) time a code
// is successfully consumed (MfaService.consumeRecoveryCode) - a used code
// is never deleted, just marked, so "how many of your original codes are
// left" (GET /auth/mfa/status) can be computed without losing history.
// Regenerating or disabling MFA deletes every row for the user outright
// (old codes must never remain valid once a new batch is issued).
model MfaRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Tahap 2 Step 2 Sprint 2a (MFA Enforcement) - "remember this device": a
// long-lived, revocable grant to skip the MFA challenge on a specific
// browser. Deliberately NOT a stateless JWT cookie - revocation (an
// explicit requirement) needs a DB row that can be invalidated before its
// natural expiry, same reasoning Session already established for the
// refresh token instead of a long-lived stateless credential. tokenHash is
// the same "hash at rest, raw value only in the cookie" convention as
// Session.refreshTokenHash. lastUsedAt/browser/os/deviceName/ipAddress
// mirror Session's own device-metadata fields exactly, captured once at
// creation time via ua-parser-js (see AuthService.createTrustedDevice).
model TrustedDevice {
  id        String @id @default(cuid())
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String @unique

  deviceName String?
  browser    String?
  os         String?
  ipAddress  String?

  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  @@index([userId])
}

// Tahap 3 Sprint 1 (Passkey Foundation, WebAuthn) - one row per registered
// authenticator credential. Closer in kind to OAuthIdentity than to
// TrustedDevice/Session above: it's a login-CAPABLE credential (Sprint 2),
// not a short-lived grant with its own revocation lifecycle worth
// preserving - so deletion is a hard delete (see
// PasskeyService.deletePasskey, same deleteMany-by-userId+id pattern as
// AuthService.unlinkOAuthProvider), and there is deliberately no
// `revokedAt` column here. The audit trail lives in SecurityEvent
// (PASSKEY_ADDED/PASSKEY_REMOVED), not on this row.
//
// This sprint only wires enrollment (register/list/rename/delete while
// already logged in) - see passkey.service.ts's own comment - but the
// schema is already shaped for Sprint 2 (login) so that lands without a
// second migration, same "widen now, wire the consumer later" posture as
// every other schema-ahead-of-consumer column in this file.
//
// credentialId is the authenticator-generated credential ID, base64url
// text (WebAuthn's own wire encoding - stored as the string form, not raw
// bytes, so it round-trips through JSON/Prisma without a binary column).
// publicKey is the COSE public key, stored as raw bytes (Bytes) - this is
// what verifies future assertions, never a secret the way mfaSecret is
// (a public key is safe at rest, no encryption needed). counter is the
// authenticator's signature counter, used to detect a cloned authenticator
// (Sprint 2's verify step must reject a counter that goes backward or fails
// to increase per @simplewebauthn/server's own guidance - some platform
// authenticators always report 0, which is a documented exception, not a
// clone signal). deviceType/backedUp mirror @simplewebauthn/server's own
// credentialDeviceType ('singleDevice' | 'multiDevice') /
// credentialBackedUp output - 'multiDevice'+backedUp=true is a synced
// passkey (iCloud Keychain/Google Password Manager), 'singleDevice' is a
// hardware security key or a platform authenticator with no sync. name is
// the user-chosen label shown in the Accounts page list (e.g. "MacBook
// Touch ID", "YubiKey") - captured once at registration, editable via
// rename, never auto-derived from the WebAuthn CEREMONY data itself (the
// attestation/clientDataJSON carry no human-readable device info at all).
// createdDeviceLabel (Tahap 3.5) is a SEPARATE thing - a ua-parser-js
// summary (e.g. "Chrome on macOS") of the enclosing HTTP request's own
// User-Agent header at registration time, same primitive Session/
// TrustedDevice already use for their own deviceName/browser/os. That
// header exists on the plain POST wrapping the ceremony regardless of what
// WebAuthn itself carries - shown as secondary/muted text alongside the
// user's own `name` in the Accounts UI, never used to override it. Null
// for passkeys registered before this column existed.
model Passkey {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId       String   @unique
  publicKey          Bytes
  counter            BigInt   @default(0)
  deviceType         String
  backedUp           Boolean  @default(false)
  transports         String[] @default([])
  name               String
  createdDeviceLabel String?

  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  @@index([userId])
}

// Sprint 5C (Comments). Video-scoped (clipId optional - a comment can
// anchor to a specific clip, or just the video as a whole), threaded via
// a self-relation (parentId null = a root/top-level comment; only root
// comments can be resolved - a reply inherits its thread's resolved state
// rather than carrying its own, same "resolve the whole thread" semantics
// as Figma/Notion). timestampSeconds anchors a comment to a specific
// moment (clip-relative if clipId is set, otherwise video-relative) - null
// for a general, not-time-anchored comment.
model Comment {
  id               String    @id @default(cuid())
  videoId          String
  video            Video     @relation(fields: [videoId], references: [id], onDelete: Cascade)
  clipId           String?
  clip             Clip?     @relation(fields: [clipId], references: [id], onDelete: Cascade)
  authorId         String
  author           User      @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  parentId         String?
  parent           Comment?  @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies          Comment[] @relation("CommentThread")
  body             String
  timestampSeconds Float?
  resolved         Boolean   @default(false)
  resolvedAt       DateTime?
  resolvedById     String?
  resolvedBy       User?     @relation("CommentResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  editedAt         DateTime?
  createdAt        DateTime  @default(now())

  mentions    CommentMention[]
  reactions   CommentReaction[]
  attachments CommentAttachment[]

  @@index([videoId, createdAt])
  @@index([clipId])
  @@index([parentId])
}

// A row per (comment, mentioned user) pair - drives the MENTION
// notification and lets the frontend render "@Name" for a user who may
// since have left the workspace (the row/relation survives independent of
// current WorkspaceMembership).
model CommentMention {
  id        String   @id @default(cuid())
  commentId String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([commentId, userId])
}

// One row per (comment, user, emoji) - a user can react to the same
// comment with several different emoji, but not the same emoji twice
// (toggling calls DELETE, not a second POST).
model CommentReaction {
  id        String   @id @default(cuid())
  commentId String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime @default(now())

  @@unique([commentId, userId, emoji])
}

// One file per attachment row (a comment can have several). storageKey is
// never exposed to the client raw - same "endpoint path instead" treatment
// as every other resource's stored object key in this codebase.
model CommentAttachment {
  id          String   @id @default(cuid())
  commentId   String
  comment     Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  storageKey  String
  fileName    String
  fileSize    Int
  contentType String
  createdAt   DateTime @default(now())

  @@index([commentId])
}

// Sprint 5D (Approval). PENDING is the only non-terminal-looking state
// that's actually re-enterable - NEEDS_REVISION/REJECTED can both go back
// to PENDING via CommentsService-sibling ApprovalService.resubmit(),
// appending a new ApprovalEvent rather than mutating history away. APPROVED
// is the only state this codebase treats as a real terminal state (no
// resubmit path) - matches this workflow's real-world meaning ("this
// specific version was approved"), not a UI restriction.
enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  NEEDS_REVISION
}

// Video-scoped (clipId optional - an approval can target one specific
// clip, the more common case since clips are the actual publishable unit,
// or the video as a whole). Only one active (PENDING or NEEDS_REVISION)
// Approval may exist per clipId/videoId pair at a time - enforced at the
// service layer (ApprovalService.request), not the schema, same
// "cross-field invariant lives in the service" convention as
// ExportJob's type/videoId mutual exclusion.
model Approval {
  id            String         @id @default(cuid())
  videoId       String
  video         Video          @relation(fields: [videoId], references: [id], onDelete: Cascade)
  clipId        String?
  clip          Clip?          @relation(fields: [clipId], references: [id], onDelete: Cascade)
  status        ApprovalStatus @default(PENDING)
  requestedById String
  requestedBy   User           @relation("ApprovalRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  // Set at request time if the requester named a specific reviewer
  // (validated as a real REVIEWER+ workspace member); null means "anyone
  // REVIEWER+ can pick this up," and the REVIEW_REQUEST notification falls
  // back to the video's owner.
  reviewerId    String?
  reviewer      User?          @relation("ApprovalReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  note          String?
  reviewedAt    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  events ApprovalEvent[]

  @@index([videoId])
  @@index([clipId])
}

// Audit trail of every status transition - the current Approval row only
// shows the latest state, not the sequence of who requested/decided/
// resubmitted when, same "separate history table, not just a current-state
// column" reasoning as VideoStatusEvent.
model ApprovalEvent {
  id         String         @id @default(cuid())
  approvalId String
  approval   Approval       @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  status     ApprovalStatus
  actorId    String
  actor      User           @relation(fields: [actorId], references: [id], onDelete: Cascade)
  note       String?
  createdAt  DateTime       @default(now())

  @@index([approvalId, createdAt])
}

// Sprint 5E (Version Compare & History). render-clip.worker.ts overwrites
// Clip.outputUrl/thumbnailUrl/etc. in place on every re-render with zero
// history - this is what actually preserves it. A row is snapshotted by
// ClipsService.render() right before it clears the live Clip row and
// enqueues the new render job, so a ClipVersion always represents "what
// this clip looked like right before this specific re-render" - the CURRENT
// state always lives on the Clip row itself, never duplicated into a
// ClipVersion until it's about to be superseded. versionNumber is
// sequential per clip (1, 2, 3...), assigned as
// (existing ClipVersion count for this clip) + 1. Deliberately a snapshot
// of render/trim-relevant fields only (startTime/endTime/captionStyle/
// hookText/hashtags/outputUrl/outputSizeBytes/thumbnailUrl/viralityScore) -
// not the deep per-clip AI signal columns (facialFeatures, ocrTracks,
// etc.), which are frozen pipeline output tied to the CURRENT render, not
// something a Version Compare view needs to diff.
model ClipVersion {
  id              String       @id @default(cuid())
  clipId          String
  clip            Clip         @relation(fields: [clipId], references: [id], onDelete: Cascade)
  versionNumber   Int
  startTime       Float
  endTime         Float
  outputUrl       String?
  outputSizeBytes Int?
  thumbnailUrl    String?
  captionStyle    CaptionStyle
  hookText        String?
  hashtags        String[]
  viralityScore   Float
  createdById     String
  createdBy       User         @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt       DateTime     @default(now())

  @@unique([clipId, versionNumber])
  @@index([clipId, versionNumber])
}

// Sprint 5F (Audit Log). Deliberately a THIRD, separate model from
// ActivityEvent and Notification, not a rename/extension of either -
// ActivityEvent is a personal "what happened to my stuff" feed (Dashboard's
// Activity Timeline, userId-scoped, a handful of creator-facing types);
// Notification is "what was delivered to me" (has read-state, delivery
// channels); AuditLogEntry is a workspace-scoped governance/security record
// ("who changed what shared state, and when"), readable only by ADMIN+
// (see ApprovalsController's own role-gating precedent) - closer in spirit
// to Milestone 5C-B's role-gated Ops Dashboard than to either of the other
// two feeds. targetType/targetId are free-form (not a real FK) since the
// target row (a Comment, a WorkspaceMembership, a Video) may since have
// been deleted - same "metadata survives the thing it describes" reasoning
// ActivityEvent.metadata's own comment gives for a deleted video/clip.
//
// Scoped to the governance-relevant actions an admin would actually audit
// for security/compliance (membership/role changes, invites, project/
// folder/video/clip deletion, share link lifecycle, approval decisions) -
// deliberately NOT every comment/reaction/edit, which would make this log
// noisy without adding real audit value (comments already have their own
// thread history; ClipVersion already captures render history with its own
// createdBy/createdAt).
enum AuditAction {
  MEMBER_ROLE_CHANGED
  MEMBER_REMOVED
  INVITE_CREATED
  INVITE_ACCEPTED
  PROJECT_CREATED
  PROJECT_DELETED
  PROJECT_ARCHIVED
  PROJECT_UNARCHIVED
  PROJECT_MOVED
  WORKSPACE_OWNERSHIP_TRANSFERRED
  FOLDER_CREATED
  FOLDER_DELETED
  VIDEO_MOVED
  VIDEO_DELETED
  CLIP_DELETED
  SHARE_LINK_CREATED
  SHARE_LINK_REVOKED
  APPROVAL_DECIDED
  // Publishing Expansion Phase 6 (Scheduling) - selective, same posture as
  // Project's own audit trail: log create/cancel/delete, not every plain
  // edit (see ProjectService, which only calls recordAuditLog from
  // create()/remove()).
  CAMPAIGN_CREATED
  CAMPAIGN_CANCELLED
  RECURRING_SCHEDULE_CREATED
  RECURRING_SCHEDULE_DELETED
  // Workspace Lifecycle Management roadmap - WORKSPACE_LEFT logs normally
  // here (the workspace itself isn't deleted, same as MEMBER_REMOVED).
  // Deliberately NO WORKSPACE_DELETED entry in this enum: AuditLogEntry.
  // workspace is onDelete: Cascade, so a row logging a workspace's own
  // deletion would be cascade-deleted along with it in the same statement,
  // silently losing the very record it exists to keep. See
  // WorkspaceService.remove(), which logs that event to ActivityEvent
  // (userId-scoped only, survives the workspace's own deletion) instead -
  // see ActivityEventType.WORKSPACE_DELETED below.
  WORKSPACE_LEFT
}

model AuditLogEntry {
  id          String      @id @default(cuid())
  workspaceId String
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  action      AuditAction
  actorId     String
  actor       User        @relation(fields: [actorId], references: [id], onDelete: Cascade)
  targetType  String
  targetId    String?
  metadata    Json?
  createdAt   DateTime    @default(now())

  @@index([workspaceId, createdAt])
  @@index([workspaceId, action])
}

// Authentication Foundation Sprint 4 (Attack Protection) - a FOURTH,
// separate event-stream model, same "distinct model when semantics genuinely
// differ" reasoning as AuditLogEntry's own comment above. AuditLogEntry
// can't hold these: workspaceId/actorId are both required there, but a
// failed login attempt against an unknown email has neither a User nor any
// workspace context. userId/email are both deliberately soft references (no
// @relation/FK, same "targetId may since have been deleted" reasoning as
// AuditLogEntry.targetId) - security history must survive account deletion,
// and deleteAccount()'s cascade must never wipe it. email is kept alongside
// userId (not instead of it) because it's the one identifier present on
// every row, including LOGIN_FAILED attempts against emails that don't
// match any account at all.
enum SecurityEventType {
  LOGIN_SUCCESS
  LOGIN_FAILED
  REFRESH_REJECTED
  LOGOUT
  LOGOUT_ALL
  SESSION_REVOKED
  EMAIL_VERIFIED
  PASSWORD_RESET_COMPLETED
  // Tahap 2 Step 2 Sprint 1 (MFA Foundation)
  MFA_ENABLED
  MFA_DISABLED
  MFA_RECOVERY_CODES_REGENERATED
  // Tahap 2 Step 3 (OAuth Account Management)
  OAUTH_UNLINKED
  // Tahap 3 Sprint 1 (Passkey Foundation)
  PASSKEY_ADDED
  PASSKEY_REMOVED
  // Tahap 3.5 (Passkey UX & Observability) - POST /auth/elevate previously
  // recorded nothing at all, success or failure, for any of its three
  // credential types (TOTP/password/passkey) - a repeated-failure pattern
  // here is a real signal (someone trying to step up a stolen session).
  ELEVATION_SUCCESS
  ELEVATION_FAILED
}

model SecurityEvent {
  id        String            @id @default(cuid())
  userId    String?
  email     String?
  eventType SecurityEventType
  ipAddress String?
  userAgent String?
  // e.g. { riskScore, signals: [...] } on LOGIN_SUCCESS/LOGIN_FAILED,
  // { scope: 'all' | 'others' } on LOGOUT_ALL (POST /auth/logout-others
  // reuses LOGOUT_ALL rather than adding a distinct enum value for what is,
  // semantically, the same action with a narrower scope).
  metadata  Json?
  createdAt DateTime          @default(now())

  @@index([userId, createdAt])
  @@index([email, createdAt])
  @@index([eventType, createdAt])
}

// Sprint 6K (Conversion - first-party click-tracking). A Speedora-owned
// trackable redirect link (GET /r/:slug), replacing the idea of a
// self-reported Conversion number with a real, first-party measurement -
// see the project's "no fabricated business KPIs, ever" rule. Exactly one
// of publishRecordId/campaignId is set - never both, never neither -
// enforced both here (application-level guard in
// tracked-links.service.ts, for a friendly error message) AND by a
// database CHECK constraint hand-added to this model's own migration.sql
// (the real guarantee, since app-level checks can be bypassed by a bug or
// direct DB access). clickCount is a denormalized running total,
// atomically incremented alongside every real (non-bot, non-deduped)
// TrackedLinkClick insert - click volume can run far higher than publish
// volume, so every read (GET /clips/:id/performance,
// GET /campaigns/:id/analytics) stays O(1) against this counter rather
// than scanning/counting the full click-detail table.
model TrackedLink {
  id             String    @id @default(cuid())
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Short (8-char, URL-safe) and unique - see slug.util.ts. This IS the
  // public path segment creators share; never regenerated once created.
  slug           String    @unique
  // Validated at creation time only (http(s) protocol only, and rejected
  // if it would redirect back into this app's own /r/ path - see
  // tracked-links.service.ts's validateDestinationUrl()). Never
  // re-validated at redirect time.
  destinationUrl String

  publishRecordId String?
  publishRecord   PublishRecord? @relation(fields: [publishRecordId], references: [id], onDelete: Cascade)
  campaignId      String?
  campaign        Campaign?      @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  clickCount Int @default(0)

  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  clicks TrackedLinkClick[]

  @@index([workspaceId])
  @@index([publishRecordId])
  @@index([campaignId])
}

// Append-only detail history behind TrackedLink.clickCount's denormalized
// total - kept for the redirect handler's own short duplicate-click
// lookback (see redirect.service.ts) and for a possible future time-series
// drill-down, not read on every performance-page load (that reads the
// O(1) counter instead). Deliberately minimal fields - no IP address, no
// raw User-Agent string, no cookies, no fingerprinting. A short-lived
// Redis key is used for duplicate-click debouncing instead of an IP
// column, and is never written to durable storage - see the project's
// "only store what's genuinely needed for analytics and attribution"
// rule.
model TrackedLinkClick {
  id            String      @id @default(cuid())
  trackedLinkId String
  trackedLink   TrackedLink @relation(fields: [trackedLinkId], references: [id], onDelete: Cascade)
  clickedAt     DateTime    @default(now())
  // From the Referer header, if present - a real attribution signal (did
  // this click come from the actual published post, or somewhere else) -
  // truncated defensively against an oversized header at ingestion time.
  referrer      String?
  // Derived once from the User-Agent at ingestion (bot-detection.util.ts) -
  // the raw User-Agent string itself is never persisted. isBot: true rows
  // still exist (a real hit happened) but are excluded from
  // TrackedLink.clickCount and from every conversionCount this app reports -
  // an honest, bot-filtered number, not a raw hit count.
  isBot         Boolean     @default(false)

  @@index([trackedLinkId, clickedAt])
}
