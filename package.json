{
  "name": "speedora",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.23.2 <23"
  },
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "node ops/dev-server/dev.mjs",
    "dev:restart": "node ops/dev-server/dev.mjs --restart",
    "dev:supervise": "node ops/dev-server/dev.mjs --supervise",
    "dev:stop": "node ops/dev-server/stop.mjs",
    "dev:status": "node ops/dev-server/status.mjs",
    "doctor": "node ops/dev-server/doctor.mjs",
    "doctor:fix": "node ops/dev-server/doctor.mjs --fix",
    "setup:path": "node ops/dev-server/setup-path.mjs",
    "build": "pnpm --filter \"./packages/**\" build && pnpm --filter \"./apps/**\" build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "concurrently": "^8.2.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.9.0",
    "prettier": "^3.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0"
  }
}
