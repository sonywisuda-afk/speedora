# Postgres (used by docker-compose and apps/api)
POSTGRES_USER=viralclip
POSTGRES_PASSWORD=viralclip
POSTGRES_DB=viralclip
POSTGRES_PORT=5432
DATABASE_URL=postgresql://viralclip:viralclip@localhost:5432/viralclip

# Redis (used by docker-compose, apps/api, and apps/worker BullMQ queues)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
# Only enforced by docker-compose.prod.yml/docker-compose.oracle-*.yml
# (`redis-server --requirepass`) - local dev's docker-compose.yml runs Redis
# with no auth, same as REDIS_URL above having no password in it. Change
# this before running the Oracle Cloud Free hybrid split
# (docker-compose.oracle-web-api.yml), which publishes this port to the
# host instead of keeping it on a private compose network - see
# docs/deployment.md's hybrid section.
REDIS_PASSWORD=viralclip

# Automated Postgres + object-storage backups (ops/backup, docker-compose's
# `backup` service - see docs/backup-restore.md). All optional - unset
# values fall back to the defaults noted here.
# How often the backup service runs both backups (also runs once
# immediately on container start).
BACKUP_INTERVAL_HOURS=24
# Backups older than this are pruned after each successful run.
BACKUP_RETENTION_DAYS=14
# How long apps/api's GET /backups tolerates no fresh successful backup
# before reporting stale: true.
BACKUP_STALE_AFTER_HOURS=48

# Object storage (used by apps/api and apps/worker via packages/storage) for
# uploaded videos and rendered clips. Any S3-compatible provider works
# (currently configured for Cloudflare R2) - just point STORAGE_ENDPOINT at
# a different provider to switch.
# R2 endpoint format: https://<account_id>.r2.cloudflarestorage.com
STORAGE_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_BUCKET=your_bucket_name
STORAGE_ACCESS_KEY_ID=your_access_key_id
STORAGE_SECRET_ACCESS_KEY=your_secret_access_key
STORAGE_FORCE_PATH_STYLE=true

# apps/api
API_PORT=3001
# Allowed CORS origin for browser requests from apps/web
WEB_ORIGIN=http://localhost:3000
# Secret used to sign auth JWTs. Generate your own: openssl rand -hex 32
JWT_SECRET=replace_with_a_long_random_string
# Authentication Foundation Sprint 1 - access token lifetime (short-lived;
# renewed via POST /auth/refresh using the paired refresh token below) and
# the Session's refresh-token sliding-expiry window. Supported units: s/m/h/d.
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
# Authentication Foundation Sprint 4 - Cloudflare Turnstile secret key, used
# server-side to verify a solved widget token (POST /auth/login, only when
# risk score >= threshold). Optional at boot, same graceful-degradation
# posture as SMTP_HOST - unset means CAPTCHA verification is skipped
# entirely rather than blocking login. Get one at
# https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SECRET_KEY=
# Tahap 2 Step 1 (OAuth Login) - "Continue with Google" reuses the SAME
# GOOGLE_OAUTH_CLIENT_ID/SECRET already configured below for YouTube
# publishing (one Google Cloud OAuth client can register multiple redirect
# URIs and request different scopes per flow) - just add
# http://localhost:3001/auth/oauth/google/callback as an ADDITIONAL
# authorized redirect URI on that same client, no new Google Cloud app
# needed. GitHub has no equivalent existing app - create one at
# https://github.com/settings/developers ("New OAuth App"), and set its
# "Authorization callback URL" to
# http://localhost:3001/auth/oauth/github/callback. Both are optional at
# boot, same posture as GOOGLE_OAUTH_CLIENT_ID below - unset just means that
# provider's "Continue with..." link 503s if clicked.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# apps/web
NEXT_PUBLIC_API_URL=http://localhost:3001
# Authentication Foundation Sprint 4 - Cloudflare Turnstile's public site
# key, safe to expose to the browser (same posture as
# NEXT_PUBLIC_MIDTRANS_CLIENT_KEY below). Paired with TURNSTILE_SECRET_KEY
# above - both come from the same Turnstile site.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Premium transcription checkout (Midtrans Snap.js) - the public client key
# from the same Midtrans account as MIDTRANS_SERVER_KEY/MIDTRANS_CLIENT_KEY
# below. Safe to expose to the browser (that's what it's for); leaving it
# unset just means the "Bayar & Pakai OpenAI" button fails with a clear
# error instead of a broken Snap.js embed. See the Midtrans setup section
# further down for where to get it.
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
# 'true' loads Midtrans's production Snap.js instead of sandbox. Must match
# MIDTRANS_IS_PRODUCTION below - a mismatch means the client key and server
# key belong to different environments and checkout will fail.
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION=false

# apps/worker - Groq Whisper large-v3-turbo (the free, default transcription
# tier every video uses unless the user pays for premium - see CLAUDE.md's
# "Premium Transcription" section). Required at boot, unlike OPENAI_API_KEY
# below - get a free key at https://console.groq.com/keys.
GROQ_API_KEY=your_groq_key_here
# apps/worker - OpenAI Whisper (whisper-1), the paid "premium" transcription
# tier gated by a PremiumCredit (see MIDTRANS_* below); also used for
# clip-scoring/subtitle-translate's LLM calls (gpt-4o-mini). Also read by
# apps/api for Natural Language AI Search (P4, clip-query-parser) - the
# first apps/api feature to call OpenAI directly/synchronously rather than
# via an apps/worker job. Optional in both apps - each one without this set
# still boots and runs everything else normally; only the specific
# AI-dependent job/endpoint fails, clearly, until it's set. Get a key at
# https://platform.openai.com/api-keys.
OPENAI_API_KEY=your_openai_key_here
# apps/worker - speaker diarization (see CLAUDE.md's Fase 12 section).
# Optional - a worker without this set still transcribes/clips/renders
# normally, just without speaker labels (transcribe.worker.ts treats a
# missing token the same as any other diarization failure: skip it for this
# video, don't fail the job). pyannote/speaker-diarization-community-1 is
# gated - before this works you must (1) create a free Hugging Face
# account, (2) accept its terms at
# https://huggingface.co/pyannote/speaker-diarization-community-1, then
# (3) generate a read-scoped token at https://huggingface.co/settings/tokens.
# (Not speaker-diarization-3.1 - see diarize_speakers.py's comment on why.)
HUGGINGFACE_TOKEN=
# apps/worker - Auto B-roll (Fase 15, extended to 3 providers behind an
# Adapter pattern in Fase 16 - see CLAUDE.md). All three keys below are
# independently optional - StockAssetService (apps/worker/src/assets/)
# tries whichever providers ARE configured and simply skips ones that
# aren't; with none configured, every clip still renders normally, just
# without B-roll cutaways.
#
# Pexels (Tier 1 - video). Free, no payment method required - sign up at
# https://www.pexels.com/api/ and the key is shown immediately on your
# dashboard.
PEXELS_API_KEY=
# Pixabay (Tier 1 - video). Free, no payment method required - sign up at
# https://pixabay.com/api/docs/ ("Get started" -> your API key is on your
# account page).
PIXABAY_API_KEY=
# Unsplash (Tier 2 - photos only, tried after Pexels/Pixabay find nothing).
# Free - create an app at https://unsplash.com/oauth/applications to get an
# Access Key. Demo apps are capped at 50 requests/hour, which
# StockAssetService's per-keyword caching helps stay under.
UNSPLASH_ACCESS_KEY=
# Path to the ffmpeg binary used by the render-clip job. Defaults to "ffmpeg"
# (assumes it's on PATH); override with an absolute path if it isn't.
FFMPEG_PATH=ffmpeg
# Path to the yt-dlp binary used by the import-youtube job. Defaults to
# "yt-dlp" (assumes it's on PATH, e.g. via `pip install yt-dlp`); override
# with an absolute path if it isn't.
YTDLP_PATH=yt-dlp
# VideoImportEngine (@speedora/video-import-engine) reliability/config knobs
# for the yt-dlp download itself - all optional, every one has a safe
# default (see apps/worker/src/env.ts and packages/video-import-engine/src/
# config.ts). Left blank/unset here since the defaults are fine for local
# dev; uncomment and set only what you need to override.
# VIDEO_IMPORT_TIMEOUT_MS=3600000
# VIDEO_IMPORT_MAX_RETRIES=2
# VIDEO_IMPORT_BACKOFF_BASE_MS=2000
# VIDEO_IMPORT_BACKOFF_FACTOR=2
# VIDEO_IMPORT_BACKOFF_MAX_MS=30000
# YTDLP_COOKIES_FILE=
# YTDLP_PROXY_URL=
# YTDLP_EXTRA_ARGS=
# YTDLP_ALLOWED_DOMAINS=youtube.com,www.youtube.com,m.youtube.com,youtu.be
# VIDEO_IMPORT_SCRATCH_DIR=
# YTDLP_MIN_VERSION=
# VIDEO_IMPORT_MAX_FILE_SIZE_BYTES=
# VIDEO_IMPORT_KILL_GRACE_MS=5000
# Download Reliability Framework - how long the worker caches a yt-dlp
# health check (engine.checkVersion()) before re-checking, in the
# import-youtube job's pre-flight gate (apps/worker/src/workers/
# import-youtube.worker.ts). Also optional, safe default.
# VIDEO_IMPORT_HEALTH_CACHE_TTL_MS=300000
# How many rolling-window 'internal'-category (crash) import failures
# trigger the video-import-crash-spike AlertRule (apps/worker/src/workers/
# alert-engine.worker.ts) - see docs/video-import-reliability.md and
# docs/alerting.md.
# IMPORT_CRASH_ALERT_THRESHOLD=5
# Oracle Cloud Free hybrid deployment (Fase 2, see docs/deployment.md) -
# restricts this worker process to a comma-separated subset of queues
# instead of all 16 (apps/worker/src/workerQueueSelection.ts validates the
# names at boot). Left unset/blank in local dev and in
# docker-compose.prod.yml - every queue runs in one process, same as today.
# WORKER_QUEUES=
# Oracle Cloud Free hybrid deployment (Fase 3, see docs/deployment.md) - a
# stable, human-readable id for this worker process, reported by
# apps/worker/src/workerHeartbeat.ts and read back by apps/api's
# GET /workers/health. Optional - defaults to hostname-pid, which is fine
# for local dev but not meaningful inside a container (whose hostname is
# normally a random container id), so the Oracle worker-group compose files
# (docker-compose.oracle-worker-light.yml et al) always set this explicitly.
# WORKER_ID=
# How often (ms) and how long (s) apps/worker's heartbeat key lives in Redis
# - both optional, safe defaults (15000ms / 45s) in workerHeartbeat.ts. The
# TTL is deliberately a few intervals wide so one missed beat under load
# doesn't flip a healthy worker to "offline" in GET /workers/health. Both
# are validated at boot (env.ts's validateEnv()) if set - must be positive
# numbers, and WORKER_HEARTBEAT_TTL_SECONDS (converted to ms) must be
# greater than WORKER_HEARTBEAT_INTERVAL_MS, or a healthy worker's key could
# expire between beats.
# WORKER_HEARTBEAT_INTERVAL_MS=15000
# WORKER_HEARTBEAT_TTL_SECONDS=45

# Observability (apps/api and apps/worker both read this). Optional - leave
# blank/unset in local dev, Sentry.init() just disables itself without a
# dsn. Get your own project DSN from sentry.io; this is a placeholder, not
# a real value.
SENTRY_DSN=

# Forgot-password email (apps/api's MailService, via nodemailer). Optional -
# leave SMTP_HOST blank/unset in local dev and the reset link is logged to
# the apps/api console instead of emailed, so the feature is still usable
# without an SMTP account.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@speedora.local

# Publish Center - YouTube OAuth connect (Fase 6a) and publish-clip uploads
# (Fase 6b). Read by both apps/api (connect flow) and apps/worker
# (publish-clip job, via @speedora/social) - optional in both; apps/api
# just 503s on GET /social/youtube/connect, and apps/worker just fails the
# publish-clip job (reported to Sentry) until they're set. Create your own
# OAuth client at https://console.cloud.google.com/apis/credentials (type
# "Web application"), enable the YouTube Data API v3, and add
# http://localhost:3001/social/youtube/callback as an authorized redirect URI.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Publish Center - TikTok OAuth connect + publish-clip uploads (Fase 6d).
# Same optional treatment as the Google vars above. Create your own app at
# https://developers.tiktok.com/apps (Login Kit + Content Posting API
# products, video.upload scope only - see CLAUDE.md's Fase 6d section for
# why this is "Upload to Inbox", not Direct Post), and add
# http://localhost:3001/social/tiktok/callback as a redirect URI.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Publish Center - Instagram Reels via Facebook Login (Fase 6d follow-up).
# Same optional treatment as the vars above. Requires the connecting user's
# Instagram account to be a Business/Creator account linked to a Facebook
# Page they manage - see CLAUDE.md's Fase 6d "Instagram" section for why
# this flow (over Meta's newer standalone Instagram Login) was chosen.
# Create your own app at https://developers.facebook.com/apps (Facebook
# Login + Instagram Graph API products), and add
# http://localhost:3001/social/instagram/callback as a valid OAuth redirect URI.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Publish Center - Facebook Reels (Multi-Platform Publishing Expansion,
# Phase 1). Reuses the SAME Meta app as Instagram above (just add the
# pages_manage_posts/pages_read_engagement/pages_show_list scopes to it) -
# no separate FACEBOOK_APP_ID/SECRET needed. Add
# http://localhost:3001/social/facebook/callback as a valid OAuth redirect
# URI on that same app.
# Publish Center - Threads (Multi-Platform Publishing Expansion, Phase 1).
# Threads is a SEPARATE Meta app registration from the one above (its own
# app type in the Meta Developer console, threads_basic +
# threads_content_publish products). Create your own app at
# https://developers.facebook.com/apps, and add
# http://localhost:3001/social/threads/callback as a valid OAuth redirect URI.
THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=
# Publish Center - LinkedIn (Multi-Platform Publishing Expansion, Phase 2).
# Connects the member's own personal profile (openid+profile+w_member_social
# scopes), not a company Page. Create your own app at
# https://www.linkedin.com/developers/apps (Sign In with LinkedIn using
# OpenID Connect + Share on LinkedIn products), and add
# http://localhost:3001/social/linkedin/callback as a valid OAuth redirect
# URL under the app's Auth tab.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Publish Center - Pinterest (Multi-Platform Publishing Expansion, Phase 3).
# Publishes a video Pin to the first board on the connected account (see
# PinterestOAuthClient's fetchAccountInfo comment). Create your own app at
# https://developers.pinterest.com/apps (Trial or Standard access), and add
# http://localhost:3001/social/pinterest/callback as a valid OAuth redirect
# URI under the app's settings.
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
# Publish Center - X/Twitter (Multi-Platform Publishing Expansion, Phase 4).
# BEST-EFFORT ONLY - as of Feb 2026 X has no free API tier for new developer
# apps; posting is pay-per-use ($0.015/post as of writing) or a legacy paid
# tier, a REAL ONGOING COST to whoever owns these credentials, not a one-time
# setup step like every other platform above. If billing/quota is exhausted,
# a publish attempt fails honestly (PublishRecord.errorMessage, surfaced
# as-is in the dashboard) rather than silently. Create your own app at
# https://developer.x.com/en/portal/dashboard (OAuth 2.0, confidential
# client), and add http://localhost:3001/social/x/callback as a valid
# callback URL.
X_CLIENT_ID=
X_CLIENT_SECRET=
# apps/api's own base URL as seen by the browser - used to build the
# YouTube/TikTok/Instagram/Facebook/Threads/LinkedIn/Pinterest/X OAuth
# redirect_uri. Must exactly match a redirect URI registered on all the
# OAuth clients above. Defaults
# to http://localhost:$API_PORT if unset.
API_BASE_URL=http://localhost:3001
# AES-256-GCM key used to encrypt SocialAccount access/refresh tokens at
# rest (any platform). Generate your own: openssl rand -hex 32 - unlike the
# vars above, there's no safe default for an encryption key, so leaving this
# unset just means connecting an account will fail loudly instead of
# storing tokens insecurely. Also used by Tahap 2 Step 2 (MFA Foundation) to
# encrypt User.mfaSecret at rest - see @speedora/social's token-encryption.ts.
TOKEN_ENCRYPTION_KEY=

# Premium transcription checkout - Midtrans Snap (pay-per-use, Rp 10.000 per
# video for OpenAI Whisper; see CLAUDE.md's "Premium Transcription" section).
# Read by apps/api's PaymentsModule - optional, same posture as the OAuth
# vars above: POST /payments/premium-transcription/checkout just 503s until
# these are set, everything else (including free Groq transcription) keeps
# working. Get sandbox keys from https://dashboard.sandbox.midtrans.com
# (Settings -> Access Keys) after registering at https://midtrans.com -
# sandbox keys work immediately, no approval wait, and simulate real
# payments end-to-end without moving real money.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
# 'true' switches to Midtrans's production API host. Leave 'false'/unset
# until you've moved off sandbox keys above - see
# NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION above, which must match.
MIDTRANS_IS_PRODUCTION=false
# Must exactly match the Server Key used to sign notifications - Midtrans's
# webhook (POST /payments/webhook/midtrans) verifies every notification's
# signature against this key before trusting it (see
# apps/api/src/payments/midtrans-signature.util.ts). Register this webhook
# URL in the Midtrans dashboard (Settings -> Configuration -> Payment
# Notification URL): http://localhost:3001/payments/webhook/midtrans in
# dev - use a public tunnel (e.g. ngrok) if testing a real Snap payment
# locally, since Midtrans's servers can't reach localhost directly.

# Fusion Engine v3 (Milestone 2A, see docs/ai/fusion-v3.md) - read by
# packages/fusion-ml's isFusionV3Enabled(). Currently read by NOTHING in
# apps/worker/apps/api - v2 (@speedora/fusion-engine) is the only engine
# that actually runs, and this flag has no live call site yet. Reserved for
# whichever future milestone wires a real v3 Predictor into
# render-clip.worker.ts. Optional - unset/anything other than the literal
# string 'true' means "disabled," the safe default.
FUSION_ENGINE_V3_ENABLED=false

# AI Intelligence v4, Phase 1 (Hook Prediction Engine, see docs/ai/
# intelligence-v4.md) - read by packages/hook-prediction's
# isHookPredictionEnabled(). Gates GET /clips/:id/intelligence's exposure of
# `hookPrediction` only - the render-graph node always runs and
# Clip.hookPrediction is always persisted regardless of this flag, so
# flipping it on later needs no backfill. Optional - unset/anything other
# than the literal string 'true' means "disabled," the safe default.
HOOK_PREDICTION_ENABLED=false

# AI Intelligence v4, Phase 2 (Semantic Event Detection, see docs/ai/
# intelligence-v4.md) - read by packages/semantic-events'
# isSemanticEventDetectionEnabled(). Gates GET /clips/:id/intelligence's
# exposure of `semanticEvents` only - the render-graph node always runs and
# Clip.semanticEvents is always persisted regardless of this flag, so
# flipping it on later needs no backfill. Optional - unset/anything other
# than the literal string 'true' means "disabled," the safe default.
SEMANTIC_EVENT_DETECTION_ENABLED=false

# AI Intelligence v4, Phase 3 (Narrative Graph, see docs/ai/
# intelligence-v4.md) - read by packages/narrative-graph's
# isNarrativeGraphEnabled(). Gates GET /clips/:id/intelligence's exposure
# of `narrativeGraph` only - the render-graph node always runs and
# Clip.narrativeGraph is always persisted regardless of this flag, so
# flipping it on later needs no backfill. Optional - unset/anything other
# than the literal string 'true' means "disabled," the safe default.
NARRATIVE_GRAPH_ENABLED=false

# AI Intelligence v4, Phase 4 (Contextual Momentum, see docs/ai/
# intelligence-v4.md) - read by packages/contextual-momentum's
# isContextualMomentumEnabled(). Gates GET /clips/:id/intelligence's
# exposure of `contextualMomentum` only - the render-graph node always runs
# (it's a pure composition, optional: false, no LLM call) and
# Clip.contextualMomentum is always persisted, so flipping it on later needs
# no backfill beyond clips rendered after this phase's migration. Optional -
# unset/anything other than the literal string 'true' means "disabled," the
# safe default.
CONTEXTUAL_MOMENTUM_ENABLED=false

# AI Intelligence v4, Phase 5 (Emotional Arc, see docs/ai/
# intelligence-v4.md) - read by packages/emotional-arc's
# isEmotionalArcEnabled(). Gates GET /clips/:id/intelligence's exposure of
# `emotionalArc` only - the render-graph node always runs (it's a pure
# composition, optional: false, no LLM call) and Clip.emotionalArc is
# always persisted, so flipping it on later needs no backfill beyond clips
# rendered after this phase's migration. Optional - unset/anything other
# than the literal string 'true' means "disabled," the safe default.
EMOTIONAL_ARC_ENABLED=false

# AI Intelligence v4, Phase 6 (Multi-speaker Reasoning, see docs/ai/
# intelligence-v4.md) - read by packages/multi-speaker-reasoning's
# isMultiSpeakerReasoningEnabled(). Gates GET /clips/:id/intelligence's
# exposure of `multiSpeakerBreakdown` only - the render-graph node always
# runs (it's a pure composition, optional: false, no LLM call) and
# Clip.multiSpeakerBreakdown is always persisted (as a real null for the
# majority single-speaker case, by design - not just clips predating this
# phase's migration), so flipping it on later needs no backfill beyond
# clips rendered after this phase's migration. Optional - unset/anything
# other than the literal string 'true' means "disabled," the safe default.
MULTI_SPEAKER_REASONING_ENABLED=false

# AI Intelligence v4, Phase 7 (Cross-module Fusion, spec Part 4 - Virality
# Engine, see docs/ai/intelligence-v4.md) - read by
# packages/virality-engine's isViralityEngineEnabled(). Gates
# GET /clips/:id/intelligence's exposure of `viralityPrediction` only - the
# render-graph node always runs (it's a pure composition, optional: false,
# no LLM call) and Clip.viralityPrediction is always persisted, so flipping
# it on later needs no backfill beyond clips rendered after this phase's
# migration. NOT the same as the pre-existing, unrelated Clip.viralityScore
# (Fase 8's MVP LLM clip-scoring) - see docs/ai/scoring.md. Optional -
# unset/anything other than the literal string 'true' means "disabled,"
# the safe default.
VIRALITY_ENGINE_ENABLED=false
